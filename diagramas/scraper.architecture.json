  "cards": [
    {
      "dot": "cyan",
      "title": "El portal manda",
      "items": [
        "Vista JSF sin estado: el ViewState es un literal, no un token de sesión",
        "El expediente llega en ISO-8859-1 y su propio fragmento AJAX en UTF-8",
        "Las partes y los movimientos paginan con envoltorios A4J distintos"
      ]
    },
    {
      "dot": "emerald",
      "title": "La base es la verdad",
      "items": [
        "Un id interno identifica el expediente; el número CNJ puede faltar",
        "FTS5 se mantiene con triggers, no con escrituras desde el código",
        "La precedencia de fuentes de movimientos vive en el repositorio"
      ]
    },
    {
      "dot": "rose",
      "title": "El silencio es el enemigo",
      "items": [
        "El portal falla devolviendo la página uno, no un error",
        "Cada lectura incompleta queda registrada como fallo con su motivo",
        "Un expediente sin número se marca una vez y no se reintenta"
      ]
    }
  ],
