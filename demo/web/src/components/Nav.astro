---
import { data } from '../data/index.ts'

interface Props {
  /** Which top-level section is showing. */
  current?: 'expedientes' | 'busqueda' | 'procesos' | 'chat' | null
}

const { current = null } = Astro.props
const [stats, status] = await Promise.all([data.archiveStats(), data.status()])
const ready = status.kind === 'ready'

const links = [
  { key: 'expedientes', href: '/', label: 'Expedientes' },
  { key: 'busqueda', href: '/busqueda', label: 'Búsqueda' },
  // The queue was reachable only through the status pill, which reads as an
  // indicator rather than a way in. It is a section like the others.
  { key: 'procesos', href: '/procesos', label: 'Procesos' },
  { key: 'chat', href: '/chat', label: 'Chat' },
] as const
---

<header class="nav">
  <a class="nav__brand" href="/">
    <span class="nav__wordmark">TRF5</span>
    <span class="nav__slash">/</span>
    <span class="nav__product">Consulta Procesal</span>
  </a>

  <nav class="nav__links" aria-label="Secciones">
    {
      links.map((l) => (
        <a class="nav__link" href={l.href} aria-current={current === l.key ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
    <a
      class="status-pill"
      href="/procesos"
      title={ready
        ? 'Estado de la captura — abre los procesos en curso'
        : 'No hay acervo que leer — abre los procesos en curso'}
    >
      {/*
        Two things in one place, because they answer the same question from
        opposite ends: what the acervo is, and what is happening to it right
        now. A capture takes minutes and its progress used to live only on the
        queue screen — so anywhere else, the site looked idle while a worker
        was busy. This says so on every page, and stays quiet when nothing is
        running.
      */}
      <span class:list={['dot', ready ? 'dot--ok' : 'dot--bad']} data-nav-dot></span>
      <span data-nav-text>{ready ? `Sincronizado ${stats.lastSyncLabel}` : 'Sin acervo'}</span>
    </a>
  </nav>
</header>
