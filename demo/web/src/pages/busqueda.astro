---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { data, PORTAL_ROW_LIMIT } from '../data/index.ts'
import { formatInt, formatSeconds } from '../lib/format.ts'

/**
 * Search runs against the captured acervo, not against the portal's public
 * form — that form is where `PORTAL_ROW_LIMIT` comes from, and it is exactly
 * why this screen does not use it: a query the server cuts at thirty rows with
 * no page two cannot answer a question about a corpus. The crawl is what buys
 * coverage; this is the index over what the crawl brought back.
 */
const PAGE_SIZE = 10

const params = Astro.url.searchParams
const query = (params.get('q') ?? '').trim()
const requestedPage = Number.parseInt(params.get('p') ?? '1', 10)
const jumpTo = (params.get('numero') ?? '').trim()

// A number typed into the direct-jump field is a lookup, not a search: if the
// case is in the acervo the answer is its file, not a list of one.
if (jumpTo !== '') {
  const found = await data.getCase(jumpTo)
  if (found !== null) return Astro.redirect(`/expedientes/${found.number}`)
}

const result = await data.search(query, Number.isFinite(requestedPage) ? requestedPage : 1, PAGE_SIZE)

const first = result.hits.length === 0 ? 0 : (result.page - 1) * result.pageSize + 1
const last = first === 0 ? 0 : first + result.hits.length - 1

const pageHref = (n: number): string => {
  const next = new URLSearchParams({ q: query })
  if (n > 1) next.set('p', String(n))
  return `/busqueda?${next.toString()}`
}

const MATCHED_LABEL = {
  case: 'datos del proceso',
  party: 'partes',
  document: 'documentos',
} as const

const SYNTAX = [
  ['"em nome próprio"', 'una frase exacta, en ese orden'],
  ['prescri*', 'un prefijo: prescrição, prescrito, prescricional'],
  ['sentença OR acórdão', 'cualquiera de los dos; también AND y NOT'],
  ['0800120-05.2024.4.05.8306', 'un número pegado tal cual, con sus puntos'],
]
---

<Base
  title="Búsqueda"
  current="busqueda"
  description="Búsqueda de texto completo sobre el acervo capturado: número, clase, órgano, partes y el texto de cada documento."
>
  <section class="head gutter">
    <p class="eyebrow">07 — BÚSQUEDA EN EL ACERVO</p>
    <h1 class="page-title page-title--md">Texto completo</h1>
    <p class="lede lede--sm">
      Sobre lo capturado: el número y la clase del proceso, el órgano, los nombres de las partes y
      el texto íntegro de cada documento descargado.
    </p>
  </section>

  <div class="split" style="--aside: 440px">
    <aside class="split__aside form-col">
      <form class="form" method="get" action="/busqueda">
        <div class="field">
          <label class="field-label" for="f-q">CONSULTA</label>
          <input
            class="input"
            id="f-q"
            name="q"
            value={query}
            autofocus
            placeholder="anuidade conselho profissional"
          />
          <p class="hint">
            Sin acentos también encuentra: <span class="mono">execucao</span> y
            <span class="mono">execução</span> son el mismo término para el índice.
          </p>
        </div>

        <button class="btn btn--block" type="submit">
          <Icon name="search" size={15} />
          Buscar en el acervo
        </button>
      </form>

      <form class="form form--jump" method="get" action="/busqueda">
        <div class="field">
          <label class="field-label" for="f-numero">Nº DE EXPEDIENTE</label>
          <input
            class="input input--mono"
            id="f-numero"
            name="numero"
            value={jumpTo}
            placeholder="0800120-05.2024.4.05.8306"
          />
          <p class="hint">Coincidencia exacta: abre la ficha directamente</p>
        </div>
        {
          jumpTo !== '' && (
            <p class="jump-miss">
              <span class="mono">{jumpTo}</span> no está en el acervo.{' '}
              <a href={`/procesos?tipo=deep_case&objetivo=${encodeURIComponent(jumpTo)}`}>
                Encolar su captura
              </a>
            </p>
          )
        }
      </form>

      <section class="aside-block">
        <h2 class="field-label">CÓMO SE ESCRIBE</h2>
        <dl class="syntax">
          {
            SYNTAX.map(([example, meaning]) => (
              <div class="syntax__row">
                <dt class="mono">{example}</dt>
                <dd>{meaning}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </aside>

    <div class="split__main results">
      <section class="cap" role="note" aria-label="Por qué esta pantalla no consulta el portal">
        <Icon name="triangle-alert" size={16} />
        <div>
          <p class="cap__title">
            El portal corta toda consulta en {formatInt(PORTAL_ROW_LIMIT)} filas. Por eso se busca aquí.
          </p>
          <p class="cap__body">
            El formulario público del TRF5 nunca devuelve más de {formatInt(PORTAL_ROW_LIMIT)}{' '}
            resultados y no ofrece paginación: el límite está en la consulta al servidor, no en la
            vista, así que ningún parámetro, página ni orden lo salva. Esta búsqueda va contra el
            acervo capturado, que no tiene ese tope — pero solo contiene lo que{' '}
            <span class="mono">crawl</span> y <span class="mono">deep</span> ya trajeron.
          </p>
        </div>
      </section>

      {
        result.error !== null && (
          <p class="feedback feedback--bad">{result.error}</p>
        )
      }

      <header class="section-head">
        <h2 class="section-head__title">RESULTADOS DEL ACERVO</h2>
        {
          query !== '' && result.error === null && (
            <p class="section-head__aside mono num">
              {result.total === 0
                ? '0 resultados'
                : `${formatInt(first)}–${formatInt(last)} de ${formatInt(result.total)}`}
              {' · '}{formatSeconds(result.elapsedMs)}
            </p>
          )
        }
      </header>

      {
        query === '' ? (
          <p class="feedback">Escribe una consulta a la izquierda.</p>
        ) : result.total === 0 && result.error === null ? (
          <p class="feedback">
            Ningún expediente capturado coincide con <span class="mono">{query}</span>. Si el
            expediente existe en el portal pero no se ha capturado, no está en este índice.
          </p>
        ) : null
      }

      <ul>
        {
          result.hits.map((h) => (
            <li class="hit">
              <a class="hit__head" href={`/expedientes/${h.number}`}>
                <span class="hit__num mono">{h.number}</span>
                <span class="hit__class">{h.className}</span>
                <span class="hit__organ">{h.organ ?? '—'}</span>
              </a>

              {
                h.snippet !== null && (
                  <p class="snippet">
                    {h.snippet.segments.map((seg) =>
                      seg.hit ? <mark class="snippet__hit">{seg.text}</mark> : <span>{seg.text}</span>
                    )}
                  </p>
                )
              }

              <p class="hit__meta">
                <span>
                  coincide en {h.matchedIn.map((m) => MATCHED_LABEL[m]).join(' · ')}
                </span>
                {
                  h.snippet !== null && (
                    <a class="hit__doc" href={`/documentos/${h.snippet.documentId}`} target="_blank" rel="noopener">
                      abrir el documento
                    </a>
                  )
                }
              </p>
            </li>
          ))
        }
      </ul>

      {
        result.pageCount > 1 && (
          <nav class="pager" aria-label="Paginación de resultados">
            <a
              class="pager__btn"
              href={pageHref(Math.max(1, result.page - 1))}
              aria-disabled={result.page === 1 ? 'true' : undefined}>Anterior</a
            >
            <span class="pager__range mono num">
              {formatInt(result.page)} / {formatInt(result.pageCount)}
            </span>
            <a
              class="pager__btn"
              href={pageHref(Math.min(result.pageCount, result.page + 1))}
              aria-disabled={result.page === result.pageCount ? 'true' : undefined}>Siguiente</a
            >
          </nav>
        )
      }

      {
        result.ftsQuery !== null && result.total > 0 && (
          <p class="explain">
            Consulta enviada al índice: <span class="mono">{result.ftsQuery}</span>
          </p>
        )
      }
    </div>
  </div>
</Base>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 48px;
    padding-bottom: 26px;
  }

  .form-col {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 8px 36px 40px var(--gutter);
  }
  .results {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 8px var(--gutter) 40px 36px;
  }
  @media (max-width: 1080px) {
    .form-col { padding-right: var(--gutter); }
    .results { padding-left: var(--gutter); padding-top: 24px; }
  }

  .form { display: flex; flex-direction: column; gap: 14px; }
  .form--jump { padding-top: 24px; border-top: 1px solid var(--line); }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .hint .mono { font-size: 11px; }

  .jump-miss { font-size: 12px; font-weight: 300; line-height: 1.5; color: var(--ink-2); }
  .jump-miss .mono { font-size: 11px; color: var(--ink); }
  .jump-miss a { border-bottom: 1px solid var(--line-strong); }

  .aside-block {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .syntax { display: flex; flex-direction: column; gap: 10px; }
  .syntax__row { display: flex; flex-direction: column; gap: 3px; }
  .syntax dt { font-size: 12px; color: var(--ink); overflow-wrap: anywhere; }
  .syntax dd { font-size: 12px; font-weight: 300; color: var(--ink-2); }

  .cap {
    display: flex;
    gap: 12px;
    padding: 16px;
    background: var(--surface);
    border-left: 2px solid var(--warn);
    border-radius: var(--radius);
  }
  .cap :global(svg) { color: var(--warn); margin-top: 2px; flex: none; }
  .cap__title { font-size: 14px; font-weight: 500; color: var(--ink); }
  .cap__body {
    margin-top: 5px;
    font-size: 13px;
    font-weight: 300;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .cap__body .mono { font-size: 12px; color: var(--ink); }

  .feedback { font-size: 14px; font-weight: 300; line-height: 1.55; color: var(--ink-2); }
  .feedback .mono { font-size: 13px; color: var(--ink); }
  .feedback--bad { color: var(--bad); }

  .hit {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
  }
  .hit__head {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr) minmax(0, 220px);
    align-items: baseline;
    gap: 16px;
  }
  .hit__num { font-size: 13px; color: var(--ink); }
  .hit__class { font-size: 14px; font-weight: 300; color: var(--ink-2); }
  .hit__organ { font-size: 12px; font-weight: 300; color: var(--ink-3); text-align: right; }

  .snippet {
    font-size: 13px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .snippet__hit {
    background: none;
    color: var(--ink);
    font-weight: 500;
    border-bottom: 1px solid var(--warn);
  }

  .hit__meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 11px;
    font-weight: 300;
    color: var(--ink-3);
  }
  .hit__doc { color: var(--ink-2); border-bottom: 1px solid var(--line-strong); }

  .pager { display: flex; align-items: center; gap: 10px; padding-top: 12px; }
  .pager__btn {
    padding: 8px 13px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 13px;
    font-weight: 300;
    color: var(--ink-2);
  }
  .pager__btn[aria-disabled='true'] { color: var(--line-strong); pointer-events: none; }
  .pager__range { font-size: 12px; color: var(--ink-3); }

  .explain { font-size: 11px; color: var(--ink-3); overflow-wrap: anywhere; }
  .explain .mono { color: var(--ink-2); }

  @media (max-width: 820px) {
    .hit__head { grid-template-columns: 1fr; gap: 4px; }
    .hit__organ { text-align: left; }
  }
</style>
