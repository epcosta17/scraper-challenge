---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { data, portal, PORTAL_ROW_LIMIT } from '../data/index.ts'
import type { SearchFilters } from '@pje/scraper'
import { formatInt, formatSeconds } from '../lib/format.ts'

/**
 * The TRF5's public search form, submitted to the TRF5.
 *
 * This screen asks the court what it has; the main screen answers what we have
 * captured. Keeping those two apart is the whole point — a search that quietly
 * answered from our own database would tell you a case does not exist when all
 * it means is that nobody has crawled it yet.
 *
 * So the criteria are the portal's, with the portal's own rules, and they are
 * enforced before a request goes out because several of them are silently
 * ignored rather than rejected by the server: a party name of one token, an
 * OAB state with no number. There is no free-text field here, because the
 * portal has none — full text over what we downloaded is a different question
 * and lives in `find` on the CLI.
 *
 * A result is thin by nature: the portal's AJAX response carries a case
 * number, its internal id and a `ca` token, and nothing else. So each hit is
 * an address, and what this page offers for it depends on whether we already
 * hold it — open the case file, or queue its capture.
 *
 * Every criterion lives in the URL under the name the CLI gives it
 * (`--party` → `?party=`), so a result can be pasted to somebody else.
 */
const params = Astro.url.searchParams
const raw = (key: string): string => (params.get(key) ?? '').trim()

const filters: SearchFilters = {
  number: raw('number'),
  from: raw('from'),
  to: raw('to'),
  class: raw('class'),
  party: raw('party'),
  lawyer: raw('lawyer'),
  document: raw('document'),
  documentType: raw('document-type') === 'cnpj' ? 'cnpj' : 'cpf',
  oab: raw('oab'),
  oabState: raw('oab-state'),
  reference: raw('reference'),
}

/** Only what was actually filled in is sent; an empty string is not a criterion. */
const stripped: SearchFilters = Object.fromEntries(
  Object.entries(filters).filter(([key, value]) =>
    value !== '' && !(key === 'documentType' && filters.document === '')),
) as SearchFilters

/** Only the criteria that were actually filled in ever reach the URL. */
const stated: ReadonlyArray<readonly [string, string]> = [
  ['number', filters.number ?? ''],
  ['from', filters.from ?? ''],
  ['to', filters.to ?? ''],
  ['class', filters.class ?? ''],
  ['party', filters.party ?? ''],
  ['lawyer', filters.lawyer ?? ''],
  ['document', filters.document ?? ''],
  ['oab', filters.oab ?? ''],
  ['oab-state', filters.oabState ?? ''],
  ['reference', filters.reference ?? ''],
]

const asked = stated.filter(([, value]) => value !== '')

/**
 * The portal is only asked once something has been filled in. An empty form
 * submitted to the TRF5 would either be refused or return whatever it feels
 * like, and either way it is a request made on nobody's behalf.
 */
const outcome = asked.length === 0 ? null : await portal.run(stripped)

/**
 * What we already hold, for the numbers that came back. One lookup for the
 * whole page rather than one per row, and it is what decides whether a hit
 * offers a case file or a capture.
 */
const held = outcome !== null && outcome.ok
  ? await data.casesByNumber(outcome.hits.map((h) => h.number))
  : new Map<string, { className: string; organ: string | null }>()

const hrefWith = (change: (p: URLSearchParams) => void): string => {
  const next = new URLSearchParams()
  for (const [key, value] of asked) next.set(key, value)
  // Meaningless on its own, so it travels only alongside a number.
  if (filters.document !== '') next.set('document-type', filters.documentType ?? 'cpf')
  change(next)
  const query = next.toString()
  return query === '' ? '/busqueda' : `/busqueda?${query}`
}

/** Dropping a criterion drops what only made sense next to it. */
const withoutHref = (key: string): string =>
  hrefWith((p) => {
    p.delete('p')
    p.delete(key)
    if (key === 'oab') p.delete('oab-state')
    if (key === 'document') p.delete('document-type')
  })

/** The chips over the results: what is narrowing them, and how to stop it. */
const CHIP_LABEL: Record<string, string> = {
  number: 'nº',
  from: 'desde',
  to: 'hasta',
  class: 'clase',
  party: 'parte',
  lawyer: 'abogado',
  document: (filters.documentType ?? 'cpf').toUpperCase(),
  oab: 'OAB',
  'oab-state': 'UF',
  reference: 'referencia',
}

const chips = asked
  // The state is shown as part of the registration it qualifies, not on its own.
  .filter(([key]) => key !== 'oab-state')
  .map(([key, value]) => ({
    key,
    label: CHIP_LABEL[key] ?? key,
    value: key === 'oab' ? `${filters.oabState ?? ''}${value}` : value,
    href: withoutHref(key),
  }))

const failed = outcome !== null && !outcome.ok ? outcome : null
const found = outcome !== null && outcome.ok ? outcome : null
---

<Base
  title="Búsqueda"
  current="busqueda"
  description="El formulario público del TRF5, consultado en vivo."
>
  <section class="head gutter">
    <p class="eyebrow">07 — BÚSQUEDA EN EL PORTAL</p>
    <h1 class="page-title page-title--md">Consulta al TRF5</h1>

    {/*
      The portal's rules, as a panel that floats on hover. Each one is
      something the server does silently rather than reporting, so they are
      worth having at hand — but they are reference, not instruction, and
      nothing on this screen should make you read past them to reach the form.

      `tabindex` and `:focus-within` are not decoration: a tooltip that only
      answers to a mouse is a tooltip half the people cannot open.
    */}
    <div class="rules">
      <span class="rules__ask" tabindex="0" role="button" aria-describedby="rules-panel">
        <span class="rules__mark" aria-hidden="true">?</span>
        <span>Reglas del portal</span>
      </span>
      <div class="rules__panel" id="rules-panel" role="tooltip">
        <dl class="syntax">
          <div class="syntax__row">
            <dt>Parte y abogado</dt>
            <dd>al menos dos nombres; con uno solo el servidor rechaza la consulta</dd>
          </div>
          <div class="syntax__row">
            <dt>OAB</dt>
            <dd>el estado no filtra sin el número, y el portal no avisa: lo ignora</dd>
          </div>
          <div class="syntax__row">
            <dt>Fechas</dt>
            <dd><span class="mono">dd/mm/aaaa</span>, sobre la fecha de autuación</dd>
          </div>
          <div class="syntax__row">
            <dt>Nº y referencia</dt>
            <dd>exactos: el portal no acepta parciales ni comodines</dd>
          </div>
          <div class="syntax__row">
            <dt>30 filas</dt>
            <dd>
              el portal corta ahí dentro de su propia consulta y no hay página dos: si sale
              recortado, la única salida es afinar la búsqueda
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <div class="split" style="--aside: 440px">
    <aside class="split__aside form-col">
      <form class="form" method="get" action="/busqueda">
        <div class="field">
          <label class="field-label" for="f-number">Nº DE EXPEDIENTE</label>
          <input
            class="input input--mono"
            id="f-number"
            name="number"
            value={filters.number}
            placeholder="0013201-41.2025.4.05.8202"
          />
          <p class="hint">Coincidencia exacta — ni parciales ni comodines</p>
        </div>

        <div class="field">
          <span class="field-label" id="f-dates">FECHA DE AUTUACIÓN</span>
          {/*
            Typed and picked, both, and the same field either way.

            The input holds dd/mm/aaaa — what the portal wants and what ends up
            in the URL — so a date can be typed, pasted or edited by hand. The
            button opens a calendar built here rather than the browser's own:
            a native `type="date"` shows and accepts whatever format the
            viewer's locale happens to use, which for an American locale is
            mm/dd and would silently mean a different day.
          */}
          <div class="pair" role="group" aria-labelledby="f-dates">
            <div class="date" data-date>
              <input
                class="input input--mono"
                name="from"
                data-date-text
                value={filters.from}
                autocomplete="off"
                aria-invalid={failed?.kind === 'invalid' ? 'true' : undefined}
                aria-label="Desde"
                placeholder="dd/mm/aaaa"
              />
              <button class="date__open" type="button" data-date-open aria-label="Abrir el calendario" aria-expanded="false">
                <Icon name="calendar" size={14} />
              </button>
            </div>
            <div class="date" data-date>
              <input
                class="input input--mono"
                name="to"
                data-date-text
                value={filters.to}
                autocomplete="off"
                aria-invalid={failed?.kind === 'invalid' ? 'true' : undefined}
                aria-label="Hasta"
                placeholder="dd/mm/aaaa"
              />
              <button class="date__open" type="button" data-date-open aria-label="Abrir el calendario" aria-expanded="false">
                <Icon name="calendar" size={14} />
              </button>
            </div>
          </div>
          <p class="hint">
            La fecha de autuación, como la filtra el portal. Escríbela o elígela en el calendario.
          </p>
        </div>

        <div class="field">
          <label class="field-label" for="f-class">CLASE JUDICIAL</label>
          <input
            class="input"
            id="f-class"
            name="class"
            value={filters.class}
            placeholder="APELAÇÃO CÍVEL"
          />
          <p class="hint">
            Como lo escribe el portal. Coincidencia parcial: <span class="mono">APELA</span> vale.
          </p>
        </div>

        <div class="field">
          <label class="field-label" for="f-party">NOMBRE DE LA PARTE</label>
          <input
            class="input"
            id="f-party"
            name="party"
            value={filters.party}
            placeholder="INSTITUTO NACIONAL DO SEGURO SOCIAL"
          />
          <p class="hint">
            Coincidencia parcial, sin acentos si se prefiere. El mínimo de dos nombres es una regla
            del portal, no del acervo: aquí basta uno. No devuelve abogados.
          </p>
        </div>

        <div class="field">
          <label class="field-label" for="f-lawyer">NOMBRE DEL ABOGADO</label>
          <input
            class="input"
            id="f-lawyer"
            name="lawyer"
            value={filters.lawyer}
            placeholder="ANGELO RONCALLI"
          />
          <p class="hint">Solo los intervinientes cuyo rol capturado es ADVOGADO</p>
        </div>

        <div class="field">
          <label class="field-label" for="f-document">CPF / CNPJ</label>
          <input
            class="input input--mono"
            id="f-document"
            name="document"
            value={filters.document}
            placeholder="000.000.000-00"
          />
          <div class="seg">
            {
              (['cpf', 'cnpj'] as const).map((kind) => (
                <label class="seg__option">
                  <input
                    class="visually-hidden"
                    type="radio"
                    name="document-type"
                    value={kind}
                    checked={(filters.documentType ?? 'cpf') === kind}
                  />
                  <span>{kind.toUpperCase()}</span>
                </label>
              ))
            }
          </div>
          <p class="hint">La puntuación da igual: se comparan los dígitos</p>
        </div>

        <div class="field">
          <span class="field-label" id="f-oab">OAB</span>
          <div class="pair pair--oab" role="group" aria-labelledby="f-oab">
            <input
              class="input input--mono"
              name="oab"
              value={filters.oab}
              aria-label="Número de OAB"
              placeholder="17669"
            />
            <div class="picker">
              <input
                class="input input--mono input--uf"
                name="oab-state"
                value={filters.oabState}
                maxlength="2"
                aria-label="Estado de la OAB"
                placeholder="UF"
              />
              <Icon name="chevron-down" size={13} />
            </div>
          </div>
          <p class="hint">
            El portal ignora el estado en silencio si va sin número, así que aquí se exigen ambos.
          </p>
        </div>

        <div class="field">
          <label class="field-label" for="f-reference">PROCESO DE REFERENCIA</label>
          <input
            class="input input--mono"
            id="f-reference"
            name="reference"
            value={filters.reference}
            placeholder="0807485-94.2025.4.05.8300"
          />
          <p class="hint">Coincidencia exacta — el expediente de origen, no este</p>
        </div>

        <div class="actions">
          <button class="btn btn--block" type="submit">
            <Icon name="search" size={15} />
            Buscar en el acervo
          </button>
          {asked.length > 0 && <a class="btn btn--ghost btn--block" href="/busqueda">Limpiar</a>}
        </div>
      </form>

    </aside>

    <div class="split__main results">

      {
        failed !== null && (
          <p class="feedback feedback--bad">
            {failed.error}
          </p>
        )
      }

      <header class="section-head">
        <h2 class="section-head__title">RESULTADOS DEL PORTAL</h2>
        {
          found !== null && (
            <p class="section-head__aside mono num">
              {found.hits.length === 0
                ? '0 resultados'
                : `${formatInt(found.hits.length)} ${found.hits.length === 1 ? 'resultado' : 'resultados'}`}
              {found.capped && ' · recortado'}
              {' · '}{formatSeconds(found.elapsedMs)}
            </p>
          )
        }
      </header>

      {
        chips.length > 0 && (
          <ul class="chips">
            {
              chips.map((chip) => (
                <li>
                  <a class="chip" href={chip.href}>
                    <span class="chip__key">{chip.label}</span>
                    <span class="chip__value">{chip.value}</span>
                    <span class="chip__x" aria-hidden="true">×</span>
                    <span class="visually-hidden">quitar este criterio</span>
                  </a>
                </li>
              ))
            }
          </ul>
        )
      }

      {
        asked.length === 0 && (
          <p class="feedback">
            Rellena cualquiera de los criterios de la izquierda y se enviarán al formulario público
            del TRF5, tal cual. Nada se consulta hasta entonces: una consulta vacía sería una
            petición al tribunal que nadie ha pedido.
          </p>
        )
      }

      {
        found !== null && found.hits.length === 0 && (
          <div class="feedback">
            <p>
              El portal no devolvió ningún expediente para{' '}
              {chips.length === 1 ? 'ese criterio' : 'esos criterios'}. La consulta sí se ejecutó:
              esto es un cero del tribunal, no un fallo.
            </p>
          </div>
        )
      }

      {
        found !== null && found.capped && (
          <p class="feedback feedback--warn">
            El portal avisó de que recortó el resultado en {formatInt(PORTAL_ROW_LIMIT)} filas. Hay
            más expedientes que cumplen estos criterios y no hay forma de pedirlos: añade un
            criterio para estrechar la consulta.
          </p>
        )
      }

      <ul>
        {
          (found?.hits ?? []).map((h) => {
            const mine = held.get(h.number)
            return (
              <li class="hit">
                {
                  mine !== undefined ? (
                    <a class="hit__head" href={`/expedientes/${h.number}`}>
                      <span class="hit__num mono">{h.number}</span>
                      <span class="hit__class">{mine.className}</span>
                      <span class="hit__organ">{mine.organ ?? '—'}</span>
                    </a>
                  ) : (
                    <div class="hit__head hit__head--plain">
                      <span class="hit__num mono">{h.number}</span>
                      <span class="hit__class hit__class--none">sin capturar</span>
                      <span class="hit__organ" />
                    </div>
                  )
                }

                <p class="hit__meta">
                  <span class="mono">id {formatInt(h.idProcessoTrf)}</span>
                  {
                    mine !== undefined
                      ? <a class="hit__doc" href={`/expedientes/${h.number}`}>abrir el expediente</a>
                      : (
                        <a
                          class="hit__doc"
                          href={`/procesos?tipo=deep_case&objetivo=${encodeURIComponent(h.number)}`}
                        >
                          capturarlo
                        </a>
                      )
                  }
                </p>
              </li>
            )
          })
        }
      </ul>

    </div>
  </div>
</Base>

<script>
  /**
   * The calendar behind each date field.
   *
   * Built here rather than borrowed from the browser because `type="date"`
   * shows and accepts dates in the viewer's locale: on an American machine
   * that is mm/dd, so `03/09` would quietly mean March and this form would
   * send the portal a different day than the one on screen. The field is
   * dd/mm/aaaa for everyone, typed or picked, and that is also what travels
   * in the URL.
   *
   * The text input stays the source of truth. The panel reads it to decide
   * which month to open on, and writes back to it — nothing else holds state.
   */
  const MONTHS = [
    'enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio',
    'julio', 'agosto', 'septiembre', 'octubre', 'noviembre', 'diciembre',
  ]
  // Monday first: the week as it is read in Spain and Brazil, not Sunday-first.
  const WEEKDAYS = ['L', 'M', 'X', 'J', 'V', 'S', 'D']

  const pad = (n: number): string => String(n).padStart(2, '0')
  const written = (y: number, m: number, d: number): string => `${pad(d)}/${pad(m + 1)}/${y}`

  /** dd/mm/aaaa → a date, or null. Rejects 31/02 rather than rolling it over. */
  function parseWritten(value: string): Date | null {
    const m = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(value.trim())
    if (!m) return null
    const [d, mo, y] = [Number(m[1]), Number(m[2]), Number(m[3])]
    const date = new Date(y, mo - 1, d)
    // Constructed in local time on purpose: a bare ISO string would be read as
    // UTC and could come back as the day before.
    return date.getFullYear() === y && date.getMonth() === mo - 1 && date.getDate() === d
      ? date
      : null
  }

  for (const field of document.querySelectorAll<HTMLElement>('[data-date]')) {
    const text = field.querySelector<HTMLInputElement>('[data-date-text]')!
    const open = field.querySelector<HTMLButtonElement>('[data-date-open]')!

    const panel = document.createElement('div')
    panel.className = 'cal'
    panel.hidden = true
    field.append(panel)

    const today = new Date()
    let shown = new Date(today.getFullYear(), today.getMonth(), 1)

    function render(): void {
      const picked = parseWritten(text.value)
      const year = shown.getFullYear()
      const month = shown.getMonth()
      const first = new Date(year, month, 1)
      // getDay() is Sunday-based; shift so Monday starts the row.
      const lead = (first.getDay() + 6) % 7
      const days = new Date(year, month + 1, 0).getDate()

      const cells: string[] = []
      for (let i = 0; i < lead; i++) cells.push('<span class="cal__pad"></span>')
      for (let d = 1; d <= days; d++) {
        const isPicked = picked !== null
          && picked.getFullYear() === year && picked.getMonth() === month && picked.getDate() === d
        const isToday = today.getFullYear() === year && today.getMonth() === month && today.getDate() === d
        cells.push(
          `<button type="button" class="cal__day${isPicked ? ' is-picked' : ''}${isToday ? ' is-today' : ''}" data-day="${d}">${d}</button>`,
        )
      }

      panel.innerHTML = `
        <div class="cal__head">
          <button type="button" class="cal__nav" data-move="-1" aria-label="Mes anterior">‹</button>
          <span class="cal__month">${MONTHS[month]} ${year}</span>
          <button type="button" class="cal__nav" data-move="1" aria-label="Mes siguiente">›</button>
        </div>
        <div class="cal__grid cal__grid--head">${WEEKDAYS.map((w) => `<span>${w}</span>`).join('')}</div>
        <div class="cal__grid">${cells.join('')}</div>
        <button type="button" class="cal__today" data-today>Hoy</button>
      `
    }

    const show = (): void => {
      // Opening on the month you already typed, rather than always on today.
      shown = parseWritten(text.value) ?? new Date(today.getFullYear(), today.getMonth(), 1)
      shown = new Date(shown.getFullYear(), shown.getMonth(), 1)
      render()
      panel.hidden = false
      open.setAttribute('aria-expanded', 'true')
    }
    const hide = (): void => {
      panel.hidden = true
      open.setAttribute('aria-expanded', 'false')
    }

    open.addEventListener('click', () => { panel.hidden ? show() : hide() })

    panel.addEventListener('click', (event) => {
      const el = (event.target as HTMLElement).closest('button')
      if (!el) return
      if (el.dataset.move) {
        shown = new Date(shown.getFullYear(), shown.getMonth() + Number(el.dataset.move), 1)
        render()
        return
      }
      if (el.dataset.today !== undefined) {
        text.value = written(today.getFullYear(), today.getMonth(), today.getDate())
        hide()
        return
      }
      if (el.dataset.day) {
        text.value = written(shown.getFullYear(), shown.getMonth(), Number(el.dataset.day))
        hide()
      }
    })

    // A calendar left open over the rest of the form is in the way; anywhere
    // outside closes it, and so does Escape.
    document.addEventListener('click', (event) => {
      if (!panel.hidden && !field.contains(event.target as Node)) hide()
    })
    field.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) { event.stopPropagation(); hide() }
    })
  }
</script>

<style>
  /* The date field, and the calendar that drops out of it. */
  .date { position: relative; }
  /* The second of the pair opens its calendar leftwards, so a 236px panel
     never hangs off the side of the column. */
  .pair > .date:last-child :global(.cal) { left: auto; right: 0; }
  .date .input { width: 100%; padding-right: 32px; }
  .date__open {
    position: absolute;
    top: 1px;
    right: 1px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: calc(100% - 2px);
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-3);
    cursor: pointer;
  }
  .date__open:hover { color: var(--ink); }
  /* The rules: a panel that floats over the page, on hover or focus. */
  .rules { position: relative; display: inline-block; margin-top: 10px; }
  .rules__ask {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: var(--ink-3);
    cursor: help;
  }
  .rules__ask:hover, .rules__ask:focus-visible { color: var(--ink-2); }
  .rules__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    font-size: 10px;
    line-height: 1;
  }
  .rules__panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    z-index: 20;
    width: min(460px, calc(100vw - 48px));
    padding: 14px 16px;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    /* The one shadow on the page: it is the only element that floats over
       another, and without it the panel reads as part of what it covers. */
    box-shadow: 0 6px 24px rgb(17 17 17 / 10%);
    opacity: 0;
    visibility: hidden;
    transition: opacity 90ms ease, visibility 90ms;
  }
  .rules:hover .rules__panel,
  .rules:focus-within .rules__panel { opacity: 1; visibility: visible; }
  .rules__panel .syntax { margin: 0; }

  .head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 48px;
    padding-bottom: 26px;
  }

  .form-col {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 8px 36px 40px var(--gutter);
  }
  .results {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 8px var(--gutter) 40px 36px;
  }
  @media (max-width: 1080px) {
    .form-col { padding-right: var(--gutter); }
    .results { padding-left: var(--gutter); padding-top: 24px; }
  }

  .form { display: flex; flex-direction: column; gap: 18px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .hint .mono { font-size: 11px; }

  .pair { display: flex; gap: 10px; }
  .pair > * { flex: 1; min-width: 0; }
  .pair--oab > .picker { flex: none; width: 104px; }

  /* A select carries the design's chevron; the native arrow is turned off so
     the two do not stack. */
  .picker { position: relative; display: flex; }
  .picker select {
    appearance: none;
    padding-right: 34px;
    cursor: pointer;
  }
  .picker :global(svg) {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--ink-3);
    pointer-events: none;
  }

  /* The design's CPF/CNPJ toggle, as two radios: the choice survives a page
     load and needs no script to be visible. */
  .seg {
    display: flex;
    align-self: flex-start;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .seg__option span {
    display: block;
    padding: 7px 14px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--ink-2);
    cursor: pointer;
  }
  .seg__option input:checked + span { background: var(--ink); color: var(--paper); }
  .seg__option input:focus-visible + span { outline: 2px solid var(--ink); outline-offset: -2px; }

  .input[aria-invalid='true'] { border-color: var(--bad); }

  .actions { display: flex; flex-direction: column; gap: 10px; padding-top: 4px; }

  .syntax { display: flex; flex-direction: column; gap: 10px; }
  .syntax__row { display: flex; flex-direction: column; gap: 3px; }
  .syntax dt { font-size: 12px; color: var(--ink); overflow-wrap: anywhere; }
  .syntax dd { font-size: 12px; font-weight: 300; color: var(--ink-2); }


  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 6px 11px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    font-size: 12px;
    font-weight: 300;
    max-width: 320px;
  }
  .chip__key { color: var(--ink-3); text-transform: lowercase; }
  .chip__value { color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .chip__x { color: var(--ink-3); }
  .chip:hover .chip__x { color: var(--bad); }

  .feedback { font-size: 14px; font-weight: 300; line-height: 1.55; color: var(--ink-2); }
  .feedback .mono { font-size: 13px; color: var(--ink); }
  .feedback--bad { color: var(--bad); }
  .miss { margin-top: 8px; }
  .miss a { border-bottom: 1px solid var(--line-strong); }

  .hit {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-block: 16px;
    border-bottom: 1px solid var(--line);
  }
  .hit__head {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr) minmax(0, 220px);
    align-items: baseline;
    gap: 16px;
  }
  .hit__num { font-size: 13px; color: var(--ink); }
  .hit__class { font-size: 14px; font-weight: 300; color: var(--ink-2); }
  .hit__organ { font-size: 12px; font-weight: 300; color: var(--ink-3); text-align: right; }

  .snippet {
    font-size: 13px;
    font-weight: 300;
    line-height: 1.6;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .snippet__hit {
    background: none;
    color: var(--ink);
    font-weight: 500;
    border-bottom: 1px solid var(--warn);
  }

  .hit__meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 11px;
    font-weight: 300;
    color: var(--ink-3);
  }
  .hit__meta .mono { font-size: 11px; }
  .hit__doc { color: var(--ink-2); border-bottom: 1px solid var(--line-strong); }

  .pager { display: flex; align-items: center; gap: 10px; padding-top: 12px; }
  .pager__btn {
    padding: 8px 13px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 13px;
    font-weight: 300;
    color: var(--ink-2);
  }
  .pager__btn[aria-disabled='true'] { color: var(--line-strong); pointer-events: none; }
  .pager__range { font-size: 12px; color: var(--ink-3); }

  .explain { font-size: 11px; color: var(--ink-3); overflow-wrap: anywhere; }
  .explain .mono { color: var(--ink-2); }

  @media (max-width: 820px) {
    .hit__head { grid-template-columns: 1fr; gap: 4px; }
    .hit__organ { text-align: left; }
  }
</style>

<style is:global>
  /*
    The calendar panel is built in the browser, so it never carries the
    attribute Astro scopes styles with — scoped rules would not match a
    single one of its elements. Global, therefore, and every selector kept
    under `.cal` so that global does not mean loose.
  */
  .cal {
    position: absolute;
    top: calc(100% + 5px);
    /* Anchored to the right in the second field so the panel does not run off
       the edge of a narrow sidebar. */
    left: 0;
    z-index: 30;
    width: 236px;
    padding: 10px;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    box-shadow: 0 6px 24px rgb(17 17 17 / 12%);
  }
  .cal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .cal__month { font-size: 12px; color: var(--ink); }
  .cal__nav {
    width: 22px;
    height: 22px;
    padding: 0;
    border: 1px solid transparent;
    background: none;
    font: inherit;
    font-size: 15px;
    line-height: 1;
    color: var(--ink-2);
    cursor: pointer;
  }
  .cal__nav:hover { border-color: var(--line); color: var(--ink); }

  .cal__grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 1px; }
  .cal__grid--head {
    margin-bottom: 4px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--line);
    font-size: 10px;
    color: var(--ink-3);
    text-align: center;
  }
  .cal__pad { display: block; }
  .cal__day {
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid transparent;
    background: none;
    font: inherit;
    font-size: 11px;
    color: var(--ink-2);
    cursor: pointer;
  }
  .cal__day:hover { border-color: var(--line-strong); color: var(--ink); }
  /* Today is outlined, the chosen day is filled: one is where you are, the
     other is what you picked, and they must not look like the same thing. */
  .cal__day.is-today { border-color: var(--line); }
  .cal__day.is-picked { background: var(--ink); border-color: var(--ink); color: var(--paper); }

  .cal__today {
    width: 100%;
    margin-top: 8px;
    padding: 4px;
    border: 1px solid var(--line);
    background: none;
    font: inherit;
    font-size: 11px;
    color: var(--ink-2);
    cursor: pointer;
  }
  .cal__today:hover { border-color: var(--line-strong); color: var(--ink); }
</style>
