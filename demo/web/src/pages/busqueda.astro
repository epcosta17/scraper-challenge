---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { data } from '../data/index.ts'
import type { PortalQuery } from '../data/types.ts'
import { formatInt, formatSeconds } from '../lib/format.ts'

const params = Astro.url.searchParams
const value = (name: string) => params.get(name) ?? ''

const query: PortalQuery = {
  caseNumber: value('numero'),
  autuacaoFrom: value('desde'),
  autuacaoTo: value('hasta'),
  className: value('clase'),
  partyName: value('parte'),
  lawyerName: value('abogado'),
  documentKind: value('tipoDoc') === 'cnpj' ? 'cnpj' : 'cpf',
  documentNumber: value('documento'),
  oabNumber: value('oabNumero'),
  oabUf: value('oabUf'),
  referenceNumber: value('referencia'),
}

const result = await data.searchPortal(query)

const UFS = [
  'AC', 'AL', 'AM', 'AP', 'BA', 'CE', 'DF', 'ES', 'GO', 'MA', 'MG', 'MS', 'MT', 'PA',
  'PB', 'PE', 'PI', 'PR', 'RJ', 'RN', 'RO', 'RR', 'RS', 'SC', 'SE', 'SP', 'TO',
]
---

<Base
  title="Búsqueda"
  current="busqueda"
  description="Consulta en vivo contra el formulario público del TRF5, con sus reglas y su tope de 30 filas."
>
  <section class="head gutter">
    <p class="eyebrow">07 — BÚSQUEDA EN EL PORTAL</p>
    <h1 class="page-title page-title--md">Consulta pública</h1>
    <p class="lede lede--sm">
      Los mismos ocho campos del formulario del TRF5, con sus reglas. Consulta en vivo contra el
      portal.
    </p>
  </section>

  <div class="split" style="--aside: 440px">
    <aside class="split__aside form-col">
      <form class="form" method="get" action="/busqueda">
        <div class="field">
          <label class="field-label" for="f-numero">Nº DE EXPEDIENTE</label>
          <input
            class="input input--mono"
            id="f-numero"
            name="numero"
            value={query.caseNumber}
            placeholder="0013201-41.2025.4.05.8202"
          />
          <p class="hint">Coincidencia exacta — el portal no acepta parciales ni comodines</p>
        </div>

        <fieldset class="field field--group">
          <legend class="field-label">FECHA DE AUTUACIÓN</legend>
          <div class="field__pair">
            <input
              class="input input--mono"
              name="desde"
              value={query.autuacaoFrom}
              placeholder="01/08/2026"
              aria-label="Desde"
            />
            <input
              class="input input--mono"
              name="hasta"
              value={query.autuacaoTo}
              placeholder="31/08/2026"
              aria-label="Hasta"
            />
          </div>
        </fieldset>

        <div class="field">
          <label class="field-label" for="f-clase">CLASE JUDICIAL</label>
          <input
            class="input"
            id="f-clase"
            name="clase"
            value={query.className}
            placeholder="Apelação Cível"
          />
          <p class="hint">132 clases del catálogo CNJ</p>
        </div>

        <div class="field">
          <label class="field-label" for="f-parte">NOMBRE DE LA PARTE</label>
          <input class="input" id="f-parte" name="parte" value={query.partyName} />
          <p class="hint">Mínimo dos nombres — el portal rechaza uno solo</p>
        </div>

        <div class="field">
          <label class="field-label" for="f-abogado">NOMBRE DEL ABOGADO</label>
          <input class="input" id="f-abogado" name="abogado" value={query.lawyerName} />
          <p class="hint">Mínimo dos nombres</p>
        </div>

        <div class="field">
          <label class="field-label" for="f-documento">CPF / CNPJ</label>
          <input
            class="input input--mono"
            id="f-documento"
            name="documento"
            value={query.documentNumber}
            placeholder={query.documentKind === 'cnpj' ? '00.000.000/0000-00' : '000.000.000-00'}
          />
          <div class="segmented segmented--tight" role="group" aria-label="Tipo de documento">
            {
              (['cpf', 'cnpj'] as const).map((k) => (
                <button
                  class="segmented__option"
                  type="submit"
                  name="tipoDoc"
                  value={k}
                  aria-pressed={query.documentKind === k}
                >
                  {k.toUpperCase()}
                </button>
              ))
            }
          </div>
        </div>

        <div class="field">
          <label class="field-label" for="f-oab">OAB</label>
          <div class="field__pair field__pair--oab">
            <input
              class="input input--mono"
              id="f-oab"
              name="oabNumero"
              value={query.oabNumber}
              placeholder="17669"
            />
            <select class="input input--mono" name="oabUf" aria-label="Estado de la OAB">
              <option value="">UF</option>
              {UFS.map((uf) => <option value={uf} selected={query.oabUf === uf}>{uf}</option>)}
            </select>
          </div>
          <p class="hint">El estado sin número se ignora en silencio: exigimos ambos</p>
        </div>

        <div class="field">
          <label class="field-label" for="f-referencia">PROCESO DE REFERENCIA</label>
          <input
            class="input input--mono"
            id="f-referencia"
            name="referencia"
            value={query.referenceNumber}
          />
          <p class="hint">Coincidencia exacta</p>
        </div>

        <button class="btn btn--block" type="submit">
          <Icon name="search" size={15} />
          Buscar en el portal
        </button>
      </form>
    </aside>

    <div class="split__main results">
      {
        result.capped && (
          <section class="cap" role="note" aria-label="Tope de resultados del portal">
            <Icon name="triangle-alert" size={16} />
            <div>
              <p class="cap__title">
                {formatInt(result.rowLimit)} resultados — el tope del servidor. Hay más.
              </p>
              <p class="cap__body">
                El portal corta toda consulta en {formatInt(result.rowLimit)} filas y no ofrece
                paginación: el límite está en la consulta al servidor, no en la vista, así que
                ningún parámetro lo salva. Para cobertura completa, usa <span class="mono">crawl</span>.
              </p>
            </div>
          </section>
        )
      }

      <header class="section-head">
        <h2 class="section-head__title">RESULTADOS DEL PORTAL</h2>
        <p class="section-head__aside mono num">
          {formatInt(result.hits.length)} de {result.capped ? '≥' : ''}{formatInt(result.hits.length)}
          {' · '}{formatSeconds(result.elapsedMs)}
        </p>
      </header>

      <ul>
        {
          result.hits.map((h) => (
            <li class="hit">
              <span class="hit__num mono">{h.number}</span>
              <span class="hit__class">{h.className}</span>
              <span class="hit__state">
                <span class:list={['dot', h.inArchive ? 'dot--ok' : 'dot--idle']} />
                {h.inArchive ? 'en el acervo' : 'sin capturar'}
              </span>
              <span class="hit__action">
                {
                  h.inArchive ? (
                    <a class="hit__open" href={`/expedientes/${h.number}`}>Abrir</a>
                  ) : (
                    <button class="btn btn--ghost btn--sm" type="button" disabled>Capturar</button>
                  )
                }
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Base>

<style>
  .head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 48px;
    padding-bottom: 26px;
  }

  .form-col { padding: 8px 36px 40px var(--gutter); }
  .results {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 8px var(--gutter) 40px 36px;
  }
  @media (max-width: 1080px) {
    .form-col { padding-right: var(--gutter); }
    .results { padding-left: var(--gutter); padding-top: 24px; }
  }

  .form { display: flex; flex-direction: column; gap: 18px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field--group { border: 0; margin: 0; padding: 0; }
  .field__pair { display: flex; gap: 10px; }
  .field__pair > * { flex: 1; min-width: 0; }
  .field__pair--oab > select { flex: none; width: 104px; }
  .field .segmented { align-self: flex-start; }

  .cap {
    display: flex;
    gap: 12px;
    padding: 16px;
    background: var(--surface);
    border-left: 2px solid var(--warn);
    border-radius: var(--radius);
  }
  .cap :global(svg) { color: var(--warn); margin-top: 2px; }
  .cap__title { font-size: 14px; font-weight: 500; color: var(--ink); }
  .cap__body {
    margin-top: 5px;
    font-size: 13px;
    font-weight: 300;
    line-height: 1.55;
    color: var(--ink-2);
  }

  .hit {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr) 150px 86px;
    align-items: center;
    gap: 16px;
    padding-block: 13px;
    border-bottom: 1px solid var(--line);
  }
  .hit__num { font-size: 13px; color: var(--ink); }
  .hit__class { font-size: 14px; font-weight: 300; color: var(--ink-2); }
  .hit__state {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
    font-size: 12px;
    font-weight: 300;
    color: var(--ink-2);
  }
  .hit__action { display: flex; justify-content: flex-end; }
  .hit__open { font-size: 12px; color: var(--ink-2); border-bottom: 1px solid var(--line-strong); }

  @media (max-width: 820px) {
    .hit { grid-template-columns: minmax(0, 1fr) auto; gap: 6px 16px; }
    .hit__num { grid-column: 1 / -1; }
    .hit__state { justify-content: flex-start; }
    .hit__action { grid-row: 2; grid-column: 2; }
  }
</style>
