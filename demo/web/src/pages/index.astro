---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import CoverageCount from '../components/CoverageCount.astro'
import { data } from '../data/index.ts'
import type { CasePage, SearchResult } from '../data/types.ts'
import { dateOnly, formatCompact, formatInt, formatPercent } from '../lib/format.ts'

/**
 * The acervo: what we have captured, listed and searched.
 *
 * The toolbar searches *here*, not at the court — full text across case
 * metadata, party names and the text of every document we downloaded, which
 * is a thing the portal cannot do at all. When it finds nothing, that is a
 * statement about our acervo and not about the TRF5, so the empty state says
 * so and offers to go ask the court instead.
 */
const PAGE_SIZE = 6

const params = Astro.url.searchParams
const raw = (key: string): string => (params.get(key) ?? '').trim()

const text = raw('q')
const clase = raw('clase')
const organo = raw('organo')
const periodo = raw('periodo')
const searching = text !== '' || clase !== '' || organo !== '' || periodo !== ''

/**
 * The period control, as ranges rather than dates: on this screen somebody is
 * skimming, and "the last month" is the question they actually have. The
 * search page is where an exact range belongs.
 */
const PERIODS: ReadonlyArray<{ key: string; label: string; days: number | null }> = [
  { key: '7d', label: 'Últimos 7 días', days: 7 },
  { key: '30d', label: 'Últimos 30 días', days: 30 },
  { key: '90d', label: 'Últimos 90 días', days: 90 },
  { key: 'year', label: 'Este año', days: null },
]

const written = (d: Date): string =>
  `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`

const periodRange = ((): { from: string; to: string } | null => {
  const chosen = PERIODS.find((p) => p.key === periodo)
  if (chosen === undefined) return null
  const now = new Date()
  const from = chosen.days === null
    ? new Date(now.getFullYear(), 0, 1)
    : new Date(now.getFullYear(), now.getMonth(), now.getDate() - chosen.days)
  return { from: written(from), to: written(now) }
})()

const requested = Number.parseInt(params.get('p') ?? '1', 10)
const pageNumber = Number.isFinite(requested) ? requested : 1

const [page, stats, classes, organs] = await Promise.all([
  searching
    ? data.search({
        text,
        filters: {
          class: clase,
          organ: organo,
          from: periodRange?.from ?? '',
          to: periodRange?.to ?? '',
        },
      }, pageNumber, PAGE_SIZE)
    : data.listCases(pageNumber, PAGE_SIZE),
  data.archiveStats(),
  data.caseClasses(),
  data.caseOrgans(),
])

/**
 * A listing and a search answer with different shapes, and they are kept
 * apart rather than flattened into one: a search hit carries why it matched
 * and a fragment of the document it matched in, and a listed case carries
 * the capture coverage that would be meaningless on a hit.
 */
const listed = searching ? [] : (page as CasePage).items
const hits = searching ? (page as SearchResult).hits : []
const shownCount = searching ? hits.length : listed.length

const first = shownCount === 0 ? 0 : (page.page - 1) * page.pageSize + 1
const last = first === 0 ? 0 : first + shownCount - 1

/** Only what was actually chosen travels in the URL. */
const asked: ReadonlyArray<readonly [string, string]> = (
  [['q', text], ['clase', clase], ['organo', organo], ['periodo', periodo]] as const
).filter(([, v]) => v !== '')

const hrefWith = (change: (p: URLSearchParams) => void): string => {
  const next = new URLSearchParams()
  for (const [k, v] of asked) next.set(k, v)
  change(next)
  const query = next.toString()
  return query === '' ? '/' : `/?${query}`
}

/**
 * Where an empty acervo search sends you.
 *
 * The portal has no free-text field, so what was typed here cannot simply be
 * handed over — it has to be read for what it is. A case number is a number,
 * a run of digits is a CPF or CNPJ, two or more words is a party name (the
 * portal refuses one). Anything else opens the form with nothing filled in,
 * which is honest: we could not translate the question, so we do not pretend
 * to have.
 */
const portalHref = ((): string => {
  const q = new URLSearchParams()
  const digits = text.replace(/\D+/g, '')
  if (/^\d{7}-\d{2}\.\d{4}\.\d\.\d{2}\.\d{4}$/.test(text)) q.set('number', text)
  else if (digits.length === 11 || digits.length === 14) {
    q.set('document', text)
    q.set('document-type', digits.length === 11 ? 'cpf' : 'cnpj')
  } else if (text.trim().split(/\s+/).filter(Boolean).length >= 2) q.set('party', text)
  if (clase !== '') q.set('class', clase)
  if (periodRange !== null) { q.set('from', periodRange.from); q.set('to', periodRange.to) }
  const query = q.toString()
  return query === '' ? '/busqueda' : `/busqueda?${query}`
})()

/** 1 2 3 … 22.237, with the ellipsis where the run is broken. */
const pageLinks: (number | null)[] = (() => {
  const out: (number | null)[] = [1, 2, 3]
  if (page.pageCount > 4) out.push(null)
  if (page.pageCount > 3) out.push(page.pageCount)
  const uniq = out.filter((n, i) => n === null || out.indexOf(n) === i)
  return uniq.filter((n) => n === null || n <= page.pageCount)
})()

/** Paging keeps whatever is narrowing the list; dropping it would page a different set. */
const href = (n: number): string =>
  hrefWith((p) => { p.delete('p'); if (n > 1) p.set('p', String(n)) })

/** Which index a hit turned up in, said in the interface's language. */
const MATCHED_LABEL = {
  case: 'datos del proceso',
  party: 'partes',
  document: 'documentos',
  movement: 'movimientos',
} as const

const columns = [
  'Nº EXPEDIENTE',
  'CLASE',
  'ÓRGANO JUZGADOR',
  'PARTES',
  'DOCS',
  'ÚLTIMO MOVIMIENTO',
]
---

<Base
  title="Expedientes"
  description="El acervo del TRF5 indexado: procesos, partes, movimentações y documentos."
  current="expedientes"
>
  <section class="head gutter">
    <p class="eyebrow">01 — ACERVO</p>
    <h1 class="page-title">Expedientes</h1>
    <p class="lede">
      {formatInt(stats.caseCount)} {stats.caseCount === 1 ? 'proceso' : 'procesos'} del Tribunal
      Regional Federal da 5ª Região, con sus partes, movimentações y documentos.
    </p>
  </section>

  <form class="toolbar gutter" method="get" action="/">
    <div class="toolbar__search">
      <Icon name="search" size={16} />
      <input
        class="toolbar__input"
        type="search"
        name="q"
        value={text}
        placeholder="Buscar por número, parte, CPF/CNPJ o texto del documento"
        aria-label="Buscar en el acervo"
      />
    </div>

    <label class="toolbar__filter">
      <span class="visually-hidden">Clase</span>
      <select name="clase">
        <option value="">Clase</option>
        {classes.map((c) => (
          <option value={c.name} selected={c.name === clase}>{c.name} ({formatInt(c.caseCount)})</option>
        ))}
      </select>
      <Icon name="chevron-down" size={14} />
    </label>

    <label class="toolbar__filter">
      <span class="visually-hidden">Órgano</span>
      <select name="organo">
        <option value="">Órgano</option>
        {organs.map((o) => (
          <option value={o.name} selected={o.name === organo}>{o.name} ({formatInt(o.caseCount)})</option>
        ))}
      </select>
      <Icon name="chevron-down" size={14} />
    </label>

    <label class="toolbar__filter">
      <span class="visually-hidden">Periodo</span>
      <select name="periodo">
        <option value="">Periodo</option>
        {PERIODS.map((p) => (
          <option value={p.key} selected={p.key === periodo}>{p.label}</option>
        ))}
      </select>
      <Icon name="chevron-down" size={14} />
    </label>

    <button class="toolbar__go" type="submit">Buscar</button>
    {asked.length > 0 && <a class="toolbar__clear" href="/">Limpiar</a>}
  </form>

  <div class="table gutter">
    <div class="table__head row-head" role="presentation">
      {columns.map((c) => <span>{c}</span>)}
    </div>

    {
      listed.map((c) => (
        <a class="case" href={`/expedientes/${c.number}`}>
          <span class="case__number mono">{c.number}</span>
          <span class="case__cell" data-label="Clase">{c.className}</span>
          <span class="case__cell" data-label="Órgano">{c.organ ?? '—'}</span>
          <span class="case__cell case__count" data-label="Partes">
            <CoverageCount value={c.parties} noun="partes" />
          </span>
          <span class="case__cell case__count" data-label="Docs">
            <CoverageCount value={c.documents} noun="documentos" dimZero />
          </span>
          <span class="case__cell case__mov" data-label="Último movimiento">
            {
              c.lastMovement === null
                ? '—'
                : `${dateOnly(c.lastMovement.timestamp)} · ${c.lastMovement.description}`
            }
          </span>
        </a>
      ))
    }
    {
      hits.map((h) => (
        <a class="case case--hit" href={`/expedientes/${h.number}`}>
          <span class="case__number mono">{h.number}</span>
          <span class="case__cell" data-label="Clase">{h.className}</span>
          <span class="case__cell" data-label="Órgano">{h.organ ?? '—'}</span>
          <span class="case__cell case__hitmeta" data-label="Coincide en">
            {h.matchedIn.length === 0
              ? 'cumple los filtros'
              : `coincide en ${h.matchedIn.map((m) => MATCHED_LABEL[m]).join(' · ')}`}
            {h.snippet !== null && (
              <span class="snippet">
                {h.snippet.segments.map((seg) =>
                  seg.hit ? <mark class="snippet__hit">{seg.text}</mark> : <span>{seg.text}</span>
                )}
              </span>
            )}
          </span>
        </a>
      ))
    }

    {
      /*
        Nothing found here is a statement about our acervo, never about the
        court: a case nobody has crawled is missing from this database and
        present at the TRF5. Saying it does not exist would be the same silent
        lie the scraper refuses everywhere else — so this says which of the
        two it knows, and offers the question it cannot answer itself.
      */
      searching && hits.length === 0 && (
        <div class="nothing">
          <p class="nothing__title">Nada en el acervo con esos criterios.</p>
          <p class="nothing__body">
            Esto habla de lo que hemos capturado, no de lo que tiene el tribunal: un expediente que
            nadie ha traído todavía no está aquí y sí está en el portal.
          </p>
          <a class="btn" href={portalHref}>
            <Icon name="search" size={14} />
            Buscarlo en el portal del TRF5
          </a>
        </div>
      )
    }

    {
      !searching && listed.length === 0 && (
        <p class="table__empty">
          {page.total === 0
            ? 'Todavía no hay ningún expediente capturado. Encola una captura desde Procesos, o llénala con el scraper.'
            : 'Esta página del acervo no tiene filas.'}{' '}
          <a class="table__empty-link" href={page.total === 0 ? '/procesos' : '/'}>
            {page.total === 0 ? 'Ir a Procesos' : 'Volver a la página 1'}
          </a>.
        </p>
      )
    }
  </div>

  <nav class="pager gutter" aria-label="Paginación del acervo">
    <p class="pager__range">
      {
        shownCount === 0
          ? `Página ${formatInt(page.page)} de ${formatInt(page.pageCount)}`
          : `Mostrando ${formatInt(first)}–${formatInt(last)} de ${formatInt(page.total)}`
      }
    </p>
    <div class="pager__controls">
      <a
        class="pager__btn"
        href={href(Math.max(1, page.page - 1))}
        aria-disabled={page.page === 1 ? 'true' : undefined}>Anterior</a
      >
      {
        pageLinks.map((n) =>
          n === null ? (
            <span class="pager__btn pager__btn--gap" aria-hidden="true">…</span>
          ) : (
            <a
              class="pager__btn"
              href={href(n)}
              aria-current={n === page.page ? 'page' : undefined}
            >
              {formatInt(n)}
            </a>
          )
        )
      }
      <a
        class="pager__btn"
        href={href(Math.min(page.pageCount, page.page + 1))}
        aria-disabled={page.page === page.pageCount ? 'true' : undefined}>Siguiente</a
      >
    </div>
  </nav>

  <section class="stat-row gutter coverage" aria-label="Cobertura del acervo">
    <div class="stat">
      <p class="stat__value num">{formatInt(stats.caseCount)}</p>
      <p class="stat__label">expedientes indexados</p>
    </div>
    <div class="stat">
      <p class="stat__value num">{formatCompact(stats.documentCount)}</p>
      <p class="stat__label">documentos descargados</p>
    </div>
    <div class="stat">
      <p class="stat__value num" title="Ids capturados o descartados, entre el primer y el último id del acervo">
        {formatPercent(stats.coveragePct)}
      </p>
      <p class="stat__label">cobertura del acervo</p>
    </div>
    <div class="stat">
      <p class="stat__value">{stats.lastSyncLabel}</p>
      <p class="stat__label">última sincronización</p>
    </div>
  </section>
</Base>

<style>
  /* The filters are real controls now: a <select> wearing the button's skin. */
  .toolbar__filter { position: relative; cursor: pointer; }
  .toolbar__filter select {
    appearance: none;
    width: 100%;
    height: 100%;
    padding: 0 26px 0 12px;
    border: 0;
    background: none;
    font: inherit;
    font-size: 13px;
    color: var(--ink-2);
    cursor: pointer;
  }
  .toolbar__filter select:focus { outline: none; }
  .toolbar__filter:hover select { color: var(--ink); }
  .toolbar__filter svg { position: absolute; right: 9px; top: 50%; transform: translateY(-50%); pointer-events: none; }

  .toolbar__go {
    padding: 0 16px;
    border: 1px solid var(--ink);
    background: var(--ink);
    font: inherit;
    font-size: 13px;
    color: var(--paper);
    cursor: pointer;
  }
  .toolbar__clear {
    display: flex;
    align-items: center;
    padding: 0 10px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .toolbar__clear:hover { color: var(--ink); }

  /* A hit row trades the capture counters for why it matched. */
  .case__hitmeta {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 12px;
    color: var(--ink-3);
  }
  .snippet { font-size: 12px; color: var(--ink-2); line-height: 1.5; }
  .snippet__hit { background: none; color: var(--ink); font-weight: 500; }

  /* Nothing in the acervo — and the way out of it. */
  .nothing {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 26px 0 30px;
    border-bottom: 1px solid var(--line);
  }
  .nothing__title { margin: 0; font-size: 15px; color: var(--ink); }
  .nothing__body { margin: 0; max-width: 62ch; font-size: 13px; color: var(--ink-3); line-height: 1.6; }
  .nothing .btn { margin-top: 6px; }

  .head {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-top: 56px;
    padding-bottom: 32px;
  }

  .toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 20px;
  }

  .toolbar__search {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1 1 320px;
    min-width: 0;
    padding: 13px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--ink-3);
  }
  .toolbar__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font-size: 14px;
    font-weight: 300;
  }
  .toolbar__input:disabled { color: var(--ink-3); -webkit-text-fill-color: var(--ink-3); }

  .toolbar__filter {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 15px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: none;
    font-size: 14px;
    font-weight: 300;
    color: var(--ink-2);
  }

  .table { display: flex; flex-direction: column; }

  .table__head,
  .case {
    display: grid;
    grid-template-columns:
      minmax(230px, 300px) minmax(150px, 210px) minmax(170px, 240px)
      90px 70px minmax(200px, 1fr);
    align-items: center;
    column-gap: 8px;
  }

  .case {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 300;
  }
  .case:hover { background: var(--surface); }
  .case__number { font-size: 13px; color: var(--ink); }
  .case__cell { min-width: 0; overflow-wrap: anywhere; }
  .case__count { font-size: 13px; }

  .table__empty {
    padding: 40px 0;
    color: var(--ink-3);
    font-size: 14px;
  }
  .table__empty-link { border-bottom: 1px solid var(--line-strong); color: var(--ink-2); }

  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 20px;
  }
  .pager__range { font-size: 13px; color: var(--ink-3); }
  .pager__controls { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .pager__btn {
    padding: 8px 13px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 13px;
    font-weight: 300;
    color: var(--ink-2);
  }
  .pager__btn[aria-current='page'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
    font-weight: 500;
  }
  .pager__btn[aria-disabled='true'] { color: var(--line-strong); pointer-events: none; }
  .pager__btn--gap { border-color: transparent; }

  .coverage { padding-bottom: 56px; }

  /* Below the width where six columns still read, each case becomes a block:
     the number keeps its line, everything else is labelled and wraps. */
  @media (max-width: 1120px) {
    .table__head { display: none; }

    .case {
      grid-template-columns: 1fr auto;
      gap: 4px 16px;
      padding: 18px 0;
    }
    .case__number { grid-column: 1 / -1; font-size: 14px; }
    .case__cell { display: flex; gap: 8px; }
    .case__cell::before {
      content: attr(data-label);
      flex: none;
      min-width: 8.5em;
      font-size: 11px;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      color: var(--ink-3);
      line-height: 1.6;
    }
    .case__cell { grid-column: 1 / -1; }
  }
</style>
