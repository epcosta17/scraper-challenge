---
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { data, runner } from '../data/index.ts'
import type { Job, JobKind } from '../data/types.ts'
import { isJobKind, JOB_KINDS } from '../data/sqlite/jobs.ts'
import { clockLabel } from '../data/sqlite/labels.ts'
import { formatInt } from '../lib/format.ts'

/**
 * The queue screen. It enqueues and it reads; it never runs a capture.
 *
 * A POST here inserts one row into `jobs` and redirects — an external worker
 * is what claims it, does the HTTP and writes the result back, progress
 * included. So the count on a running row is genuinely live: it is the
 * worker's own report, read straight off the row it is updating, not this
 * page guessing from elapsed time.
 */
let flash: { kind: 'ok' | 'bad'; text: string } | null = null

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData()

  // Running the queue and stopping it come first, and deliberately never look
  // at the target fields. They share the form only because they sit under it;
  // asking for a worker is not a kind of job, and a stop that could be refused
  // because a radio button was wrong would be a stop you cannot rely on.
  if (form.has('ejecutar')) {
    const started = runner.ensureRunning()
    return Astro.redirect(`/procesos?worker=${started.started ? 'arrancado' : 'ya'}`)
  }
  if (form.has('parar')) {
    const stopped = runner.stop()
    return Astro.redirect(`/procesos?worker=${stopped ? 'parado' : 'ninguno'}`)
  }

  const rawKind = String(form.get('tipo') ?? '')
  const target = String(form.get('objetivo') ?? '')
  if (!isJobKind(rawKind)) {
    return Astro.redirect(`/procesos?error=${encodeURIComponent('Tipo de proceso desconocido.')}`)
  }

  const outcome = await data.enqueue(rawKind, target)
  if (!outcome.ok) {
    return Astro.redirect(
      `/procesos?error=${encodeURIComponent(outcome.error)}&tipo=${rawKind}&objetivo=${encodeURIComponent(target)}`,
    )
  }
  // Queueing work is what starts a worker. Nothing is scheduled and nothing
  // runs on its own: there is a worker because somebody asked for this job.
  const started = runner.ensureRunning()
  return Astro.redirect(
    `/procesos?encolado=${outcome.job.id}&worker=${started.started ? 'arrancado' : 'ya'}`,
  )
}

const params = Astro.url.searchParams
const enqueued = params.get('encolado')
const failed = params.get('error')
const workerNote = params.get('worker')
const WORKER_SAID: Record<string, string> = {
  arrancado: 'Worker arrancado; está drenando la cola.',
  ya: 'Ya había un worker corriendo; tomará este trabajo también.',
  parado: 'Al worker se le pidió parar. Termina el trabajo que tenga en curso.',
  ninguno: 'No hay ningún worker que esta pantalla haya arrancado.',
}

if (enqueued !== null) {
  const said = workerNote !== null ? ` ${WORKER_SAID[workerNote] ?? ''}` : ''
  flash = { kind: 'ok', text: `Trabajo #${enqueued} encolado.${said}` }
} else if (failed !== null) {
  flash = { kind: 'bad', text: failed }
} else if (workerNote !== null) {
  flash = { kind: 'ok', text: WORKER_SAID[workerNote] ?? '' }
}

const worker = runner.state()

const rawKind = params.get('tipo') ?? ''
const activeMode: JobKind = isJobKind(rawKind) ? rawKind : 'deep_case'
const prefill = params.get('objetivo') ?? ''

const overview = await data.captureOverview()

const STATE_LABEL: Record<Job['state'], string> = {
  running: 'corriendo',
  queued: 'en cola',
  done: 'completado',
  failed: 'fallido',
}

/**
 * What each job type asks a worker for, and what its objetivo has to be. All
 * four are listed at once rather than swapped as the selection changes: the
 * segmented control is four radio inputs and no client script, so a hint that
 * followed the selection would be a lie until the form round-tripped.
 */
const KIND_HINT: Record<JobKind, string> = {
  deep_case: 'un expediente entero (nº o id interno)',
  refresh_case: 'relee uno ya capturado (nº o id interno)',
  deep_range: 'baja un rango entero con sus documentos: 130100–130400',
  crawl: 'recorre ids buscando expedientes; vacío sigue la marca de agua',
}

const TARGET_PLACEHOLDER = '0800120-05.2024.4.05.8306  ·  130105  ·  130100–130400'

/** The stored column is UTC; the queue prints it on the clock of whoever is reading. */
const clock = clockLabel

const kpis = [
  { value: formatInt(overview.runningJobs), label: 'procesos en curso', tone: '' },
  { value: formatInt(overview.queuedJobs), label: 'en cola', tone: '' },
  { value: formatInt(overview.casesToday), label: 'casos hoy', tone: '' },
  { value: formatInt(overview.documentsToday), label: 'documentos hoy', tone: '' },
  { value: formatInt(overview.openFailures), label: 'fallos sin resolver', tone: overview.openFailures > 0 ? 'bad' : 'muted' },
]

const columns = ['TIPO', 'OBJETIVO', 'AVANCE', 'INTENTOS', 'TIEMPOS', 'ESTADO']

/**
 * What a job's counter reads. A queued job has nothing to say yet, so it says
 * nothing rather than `0 / ?`, which would look like a run that has stalled.
 * A total of null is a run with no knowable end — the count alone is the
 * whole truth there — and `~` marks a total the worker may stop short of.
 */
function progressOf(j: Job): string | null {
  if (j.state === 'queued') return null
  const { done, total, totalIsEstimate } = j.progress
  if (total === null) return done === 0 ? null : formatInt(done)
  return `${formatInt(done)} / ${totalIsEstimate ? '~' : ''}${formatInt(total)}`
}
---

<Base
  title="Procesos"
  description="Estado de la captura: cola de trabajos, intentos, tiempos y fallos sin resolver."
  current="procesos"
>
  <section class="head gutter">
    <p class="eyebrow">06 — PROCESOS</p>
    <h1 class="page-title page-title--sm">Captura</h1>
  </section>

  <section class="kpis gutter" aria-label="Indicadores de captura">
    {
      kpis.map((k) => (
        <div class="kpi">
          <p class="kpi__value num" data-tone={k.tone}>{k.value}</p>
          <p class="kpi__label">{k.label}</p>
        </div>
      ))
    }
  </section>

  <div class="split" style="--aside: 520px">
    <div class="split__main queue">
      <header class="section-head">
        <h2 class="section-head__title">COLA DE TRABAJOS</h2>
        <p class="section-head__aside">última captura {overview.updatedAgoLabel}</p>
      </header>

      {
        overview.jobs.length === 0 ? (
          <p class="empty">
            La cola está vacía. Encola un proceso a la derecha: esta pantalla solo lo apunta, y un
            worker externo es quien lo ejecuta.
          </p>
        ) : (
          <>
            <div class="job row-head" role="presentation">
              {columns.map((c) => <span>{c}</span>)}
            </div>
            <ul data-queue>
              {overview.jobs.map((j) => (
                <li class="job job--row" data-job={j.id}>
                  <span class="job__kind mono">{j.kind}</span>
                  <span class="job__target">
                    {j.target}
                    <span class="job__stage" data-cell="stage">{j.stage ?? ''}</span>
                    {j.error !== null && <span class="job__error">{j.error}</span>}
                  </span>
                  <span class="job__progress mono num" data-cell="progress">{progressOf(j) ?? '—'}</span>
                  <span class="job__attempts mono num" data-cell="attempts">{formatInt(j.attempts)}</span>
                  <span class="job__times mono">
                    {clock(j.startedAt ?? j.createdAt)}
                    {j.finishedAt !== null && ` → ${clock(j.finishedAt)}`}
                  </span>
                  <span class="job__state" data-state={j.state}>
                    <span
                      class:list={[
                        'dot',
                        j.state === 'running' && 'dot--ok',
                        j.state === 'failed' && 'dot--bad',
                      ]}
                    />
                    {STATE_LABEL[j.state]}
                  </span>
                </li>
              ))}
            </ul>
          </>
        )
      }

      <p class="note">
        El avance lo escribe el worker en la propia fila mientras trabaja, así que esta pantalla
        lo lee, no lo estima: recarga y verás moverse el número. Cuenta expedientes en un rango y
        documentos en un expediente suelto. Un <span class="mono">~</span> delante del total marca
        una estimación, y un trabajo sin final conocido enseña solo lo hecho.
      </p>
    </div>

    <aside class="split__aside panel">
      <section class="panel__block">
        <header class="section-head">
          <h2 class="section-head__title">ENCOLAR PROCESO</h2>
        </header>

        {
          flash !== null && (
            <p class:list={['flash', flash.kind === 'bad' && 'flash--bad']} role="status">
              {flash.text}
            </p>
          )
        }

        <form class="launch" method="post" action="/procesos">
          <div class="segmented segmented--wrap" role="radiogroup" aria-label="Tipo de proceso">
            {
              JOB_KINDS.map((kind) => (
                <>
                  <input
                    class="segmented__radio"
                    type="radio"
                    name="tipo"
                    id={`tipo-${kind}`}
                    value={kind}
                    checked={kind === activeMode}
                  />
                  <label class="segmented__option" for={`tipo-${kind}`}>{kind}</label>
                </>
              ))
            }
          </div>
          <dl class="kinds">
            {
              JOB_KINDS.map((kind) => (
                <div class="kinds__row">
                  <dt class="mono">{kind}</dt>
                  <dd>{KIND_HINT[kind]}</dd>
                </div>
              ))
            }
          </dl>

          <div class="field">
            <label class="field-label" for="objetivo">OBJETIVO</label>
            <input
              class="input input--mono"
              id="objetivo"
              name="objetivo"
              value={prefill}
              placeholder={TARGET_PLACEHOLDER}
            />
          </div>

          <button class="btn btn--block" type="submit">
            <Icon name="play" size={14} />
            Encolar proceso
          </button>

          <div class="runner">
            <span class:list={['dot', worker.running && 'dot--ok']} aria-hidden="true" />
            <span class="runner__state" id="runner-state">
              {worker.running ? 'Worker corriendo' : 'Sin worker'}
            </span>
            {worker.running ? (
              <button class="runner__btn" type="submit" name="parar" value="1">Parar</button>
            ) : (
              <button class="runner__btn" type="submit" name="ejecutar" value="1">Ejecutar cola</button>
            )}
          </div>

          <p class="hint hint--lg">
            Encolar escribe una fila en <span class="mono">jobs</span> y arranca un worker si no
            hay ninguno; si ya lo hay, tomará este trabajo también. Nada está programado: existe
            un worker porque alguien pidió trabajo desde aquí. El ritmo, la concurrencia y los
            reintentos son suyos, no de esta pantalla.
          </p>
        </form>
      </section>

      <section class="panel__block">
        <header class="section-head">
          <h2 class="section-head__title">FALLOS SIN RESOLVER</h2>
          <p class="section-head__aside mono num failures__count">{formatInt(overview.openFailures)}</p>
        </header>

        {
          overview.failures.length === 0 ? (
            <p class="empty">Ninguno. Cada captura que sale bien cierra los fallos que dejó la anterior.</p>
          ) : (
            <ul>
              {overview.failures.map((f) => (
                <li class="failure">
                  <span class="failure__top">
                    <span class="mono failure__kind">{f.kind}</span>
                    <span class="mono failure__ref">{f.ref}</span>
                  </span>
                  <span class="failure__error" title={f.raw}>{f.error}</span>
                  <span class="failure__when mono">
                    {formatInt(f.attempts)} {f.attempts === 1 ? 'intento' : 'intentos'} · {f.lastAttemptAt}
                  </span>
                </li>
              ))}
            </ul>
          )
        }

        <p class="hint hint--lg">
          Un fallo se cierra solo: la siguiente captura del mismo objetivo que salga bien lo marca
          resuelto. Para reintentarlos, encola de nuevo el expediente que los produjo.
        </p>
      </section>
    </aside>
  </div>
</Base>

<script>
  /**
   * Keeps the queue table honest while a worker is working.
   *
   * A capture takes minutes and reports as it goes; a server-rendered page
   * would show none of that until somebody reloaded, which is exactly the
   * moment this screen is worth looking at. So the page is still rendered on
   * the server and this refreshes only the cells that move.
   *
   * It polls while anything is running or queued and stops the moment the
   * queue goes quiet — an idle screen makes no requests. When a job finishes
   * it reloads once, because the totals and the failure list around the table
   * are server-rendered and would otherwise disagree with the rows.
   */
  const LABEL: Record<string, string> = {
    running: 'en curso', queued: 'en cola', done: 'hecho', failed: 'falló',
  }

  const table = document.querySelector('[data-queue]')
  if (table) {
    const runnerState = document.getElementById('runner-state')
    let settled = new Set<number>()
    let primed = false

    const cell = (row: Element, name: string): HTMLElement | null =>
      row.querySelector<HTMLElement>(`[data-cell="${name}"]`)

    const tick = async (): Promise<void> => {
      let payload: any
      try {
        const response = await fetch('/cola.json', { headers: { accept: 'application/json' } })
        if (!response.ok) return
        payload = await response.json()
      } catch {
        return
      }

      if (runnerState) {
        runnerState.textContent = payload.worker?.running ? 'Worker corriendo' : 'Sin worker'
      }

      const finished = new Set<number>()
      for (const job of payload.jobs ?? []) {
        if (job.state === 'done' || job.state === 'failed') finished.add(job.id)

        const row = table.querySelector(`[data-job="${job.id}"]`)
        if (!row) continue

        const { done, total, totalIsEstimate } = job.progress ?? {}
        const progress = cell(row, 'progress')
        if (progress) {
          progress.textContent =
            job.state === 'queued' || typeof done !== 'number'
              ? '—'
              : total === null
                ? (done === 0 ? '—' : String(done))
                : `${done} / ${totalIsEstimate ? '~' : ''}${total}`
        }
        const attempts = cell(row, 'attempts')
        if (attempts) attempts.textContent = String(job.attempts)

        // The line that carries a single case through the minutes before its
        // first document exists.
        const stage = cell(row, 'stage')
        if (stage) stage.textContent = job.state === 'running' ? (job.stage ?? '') : ''

        const state = row.querySelector<HTMLElement>('.job__state')
        if (state) {
          state.dataset.state = job.state
          const dot = state.querySelector('.dot')
          dot?.classList.toggle('dot--ok', job.state === 'running')
          dot?.classList.toggle('dot--bad', job.state === 'failed')
          const label = state.lastChild
          if (label) label.textContent = LABEL[job.state] ?? job.state
        }
      }

      // A job that settled while this page was open changes the counters and
      // the failure list too, and those are rendered on the server. One reload
      // is cheaper and more honest than mirroring every one of them here.
      if (primed) {
        for (const id of finished) {
          if (!settled.has(id)) { location.reload(); return }
        }
      }
      settled = finished
      primed = true

      if (payload.active) setTimeout(tick, 1500)
    }

    void tick()
  }
</script>

<style>
  .job__stage {
    display: block;
    margin-top: 2px;
    font-size: 11px;
    color: var(--ink-3);
  }
  .job__stage:empty { display: none; }

  /* The worker's own state, under the queue form: a light, not a control panel. */
  .runner {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--ink-2);
  }
  .runner__state { flex: 1 1 auto; }
  .runner__btn {
    padding: 3px 9px;
    border: 1px solid var(--line);
    background: var(--paper);
    font: inherit;
    font-size: 12px;
    color: var(--ink-2);
    cursor: pointer;
  }
  .runner__btn:hover { border-color: var(--line-strong); color: var(--ink); }

  .head {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 48px;
    padding-bottom: 28px;
  }

  .kpis { display: flex; flex-wrap: wrap; gap: 20px 0; padding-bottom: 32px; }
  .kpi { flex: 1 1 130px; padding-right: 24px; }
  .kpi__value {
    font-size: clamp(1.4rem, 2.2vw, 1.875rem);
    font-weight: 300;
    letter-spacing: -0.6px;
  }
  .kpi__value[data-tone='bad'] { color: var(--bad); }
  .kpi__value[data-tone='muted'] { color: var(--ink-2); }
  .kpi__label { font-size: 12px; font-weight: 300; color: var(--ink-3); }

  .queue {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 0 40px 40px var(--gutter);
  }
  @media (max-width: 1080px) { .queue { padding-right: var(--gutter); } }

  .job {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) 88px 64px 132px 106px;
    align-items: baseline;
    gap: 16px;
  }
  .job--row { padding-block: 14px; border-bottom: 1px solid var(--line); }
  .job__kind { font-size: 12px; color: var(--ink); }
  .job__target { font-size: 14px; font-weight: 300; color: var(--ink-2); overflow-wrap: anywhere; }
  .job__error {
    display: block;
    margin-top: 4px;
    font-size: 12px;
    line-height: 1.45;
    color: var(--bad);
  }
  .job__attempts, .job__times { font-size: 12px; color: var(--ink-3); }
  .job__state {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
    font-size: 12px;
    color: var(--ink-2);
  }
  .job__state[data-state='failed'] { color: var(--bad); }

  @media (max-width: 860px) {
    .job { grid-template-columns: 96px minmax(0, 1fr); gap: 6px 16px; }
    .job.row-head { display: none; }
    .job__attempts, .job__times { grid-column: 1; justify-self: start; }
    .job__state { grid-column: 2; justify-content: flex-start; }
  }

  .note, .empty {
    font-size: 12px;
    font-weight: 300;
    line-height: 1.55;
    color: var(--ink-3);
  }
  .note { padding-top: 8px; }
  .note .mono { font-size: 11px; color: var(--ink-2); }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 0 var(--gutter) 40px 36px;
    background: var(--surface);
  }
  @media (max-width: 1080px) { .panel { padding: 32px var(--gutter) 40px; } }

  .panel__block { display: flex; flex-direction: column; gap: 14px; }
  .launch { display: flex; flex-direction: column; gap: 14px; }
  .field { display: flex; flex-direction: column; gap: 7px; }
  .hint--lg { font-size: 12px; line-height: 1.5; }

  .kinds { display: flex; flex-direction: column; gap: 6px; }
  .kinds__row { display: flex; gap: 10px; align-items: baseline; }
  .kinds dt { flex: none; min-width: 96px; font-size: 11px; color: var(--ink-2); }
  .kinds dd { font-size: 12px; font-weight: 300; line-height: 1.45; color: var(--ink-3); }
  @media (max-width: 520px) {
    .kinds__row { flex-direction: column; gap: 2px; }
  }
  .hint--lg .mono { font-size: 11px; color: var(--ink-2); }
  .failures__count { color: var(--bad); }

  /* The design's segmented control, as radios so it submits with the form and
     needs no client script to remember which option is chosen. */
  .segmented--wrap { flex-wrap: wrap; }
  .segmented__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  .segmented__option { flex: 1 1 auto; }
  .segmented__radio:checked + .segmented__option { background: var(--ink); color: var(--paper); }
  .segmented__radio:focus-visible + .segmented__option { outline: 2px solid var(--ink); outline-offset: -2px; }

  .flash {
    padding: 12px 14px;
    border-left: 2px solid var(--ok);
    border-radius: var(--radius);
    background: var(--paper);
    font-size: 13px;
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .flash--bad { border-left-color: var(--bad); color: var(--bad); }

  .failure {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .failure__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .failure__kind { font-size: 11px; color: var(--ink-2); }
  .failure__ref { font-size: 11px; color: var(--ink-3); }
  .failure__error { font-size: 12px; font-weight: 300; line-height: 1.45; color: var(--ink-2); }
  .failure__when { font-size: 11px; color: var(--ink-3); }
</style>
