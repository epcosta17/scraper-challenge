---
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import CoverageNotice from '../../components/CoverageNotice.astro'
import { data, runner } from '../../data/index.ts'
import { isPartial } from '../../data/types.ts'
import { formatBytes, formatInt, plural } from '../../lib/format.ts'

const { numero } = Astro.params

/**
 * Refreshing happens here, not on the queue screen.
 *
 * It still goes through the queue — this page never scrapes — but queueing is
 * not something a reader should have to navigate to do: you are looking at a
 * case, you want it re-read, and one click is the whole gesture. The redirect
 * comes straight back to this case, so the page you asked from is the page you
 * end up on, now with the job visible on it.
 */
if (Astro.request.method === 'POST' && numero) {
  const outcome = await data.enqueue('refresh_case', numero)
  if (!outcome.ok) {
    return Astro.redirect(`/expedientes/${numero}?error=${encodeURIComponent(outcome.error)}`)
  }
  // Nothing runs on its own here: a worker exists because this click asked for
  // one. If a worker is already up it takes this job too, so no second process.
  const started = runner.ensureRunning()
  return Astro.redirect(
    `/expedientes/${numero}?trabajo=${outcome.job.id}&${started.started ? 'arrancado' : 'encolado'}`,
  )
}

const caseFile = numero ? await data.getCase(numero) : null

if (caseFile === null) {
  Astro.response.status = 404
}

const params = Astro.url.searchParams
const queuedJobId = params.get('trabajo')
const queueError = params.get('error')
const workerStarted = params.has('arrancado')

const showAllMovements = params.get('movimientos') === 'todos'
const MOVEMENT_PREVIEW = 5

const capture = caseFile?.capture
const partial =
  capture !== undefined &&
  (isPartial(capture.documents) || isPartial(capture.movements) || isPartial(capture.parties))

const meta = caseFile && [
  ['ÓRGANO JUZGADOR', caseFile.organ ?? '—'],
  ['DISTRIBUCIÓN', caseFile.distributedAt ?? '—'],
  ['JURISDICCIÓN', caseFile.jurisdiction ?? '—'],
  ['PROCESO DE REFERENCIA', caseFile.referenceNumber ?? '—'],
  ['ÚLTIMA CAPTURA', caseFile.capture.lastCaptureAt ?? '—'],
]

const poloLabel = { ativo: 'ACTIVO', passivo: 'PASIVO' } as const

const movements = caseFile
  ? showAllMovements
    ? caseFile.movements
    : caseFile.movements.slice(0, MOVEMENT_PREVIEW)
  : []
---

<Base
  title={caseFile?.number ?? 'Expediente no encontrado'}
  current="expedientes"
  description={caseFile ? `${caseFile.className} · ${caseFile.organ ?? ''}` : undefined}
>
  {
    caseFile === null ? (
      <section class="missing gutter">
        <p class="eyebrow">404</p>
        <h1 class="page-title page-title--md">Ese expediente no está en el acervo</h1>
        <p class="lede">
          <span class="mono">{numero}</span> no figura entre los expedientes capturados. Puedes
          buscarlo en el portal y encolar su captura.
        </p>
        <p class="missing__actions">
          <a class="btn" href="/busqueda">Buscar en el portal</a>
          <a class="btn btn--ghost" href="/">Volver al acervo</a>
        </p>
      </section>
    ) : (
      <>
        <section class="case-head gutter">
          <nav class="crumbs" aria-label="Ruta">
            <a href="/">Expedientes</a>
            <span aria-hidden="true">/</span>
            <span class="mono">{caseFile.number}</span>
          </nav>

          {queueError !== null && (
            <p class="queued queued--bad" role="alert">{queueError}</p>
          )}

          {queuedJobId !== null && (
            <div class="queued" data-live-job={queuedJobId} role="status" aria-live="polite">
              <span class="dot dot--ok" aria-hidden="true" />
              <span class="queued__text">
                {workerStarted
                  ? `Recaptura encolada (trabajo #${queuedJobId}) y worker arrancado.`
                  : `Recaptura encolada (trabajo #${queuedJobId}). La toma el worker que ya está corriendo.`}
              </span>
              <span class="queued__progress mono" />
              <a class="queued__link" href="/procesos">Ver la cola</a>
            </div>
          )}

          <div class="case-head__row">
            <div>
              <h1 class="case-head__number">{caseFile.number}</h1>
              <p class="case-head__tags">
                <span>{caseFile.className}</span>
                {caseFile.classCode && <><span class="sep">·</span><span class="mono">{caseFile.classCode}</span></>}
                <span class="sep">·</span>
                <span>{caseFile.jurisdiction ?? 'TRF5'}{caseFile.panel ? ` · ${caseFile.panel}` : ''}</span>
              </p>
            </div>

            <div class="case-head__actions">
              <form method="POST" class="case-head__refresh">
                <button
                  class="btn"
                  type="submit"
                  title="Encola una recaptura de este expediente y arranca un worker si no hay ninguno"
                >
                  <Icon name="refresh-cw" size={15} />
                  Refrescar expediente
                </button>
              </form>
              <a
                class="btn btn--ghost"
                href={`/expedientes/${caseFile.number}/resumen.pdf`}
                title="El PDF que el portal genera del proceso entero"
              >
                <Icon name="download" size={15} />
                Resumen del proceso
              </a>
            </div>
          </div>
        </section>

        <section class="meta gutter" aria-label="Datos del proceso">
          {
            (meta ?? []).map(([k, v]) => (
              <div class="meta__cell">
                <span class="field-label">{k}</span>
                <span class="meta__value">{v}</span>
              </div>
            ))
          }
        </section>

        <div class="split" style="--aside: 520px">
          <div class="split__main body-main">
            <section class="block">
              <header class="section-head">
                <h2 class="section-head__title">02 — PARTES</h2>
                <p class="section-head__aside">
                  {
                    isPartial(caseFile.capture.parties)
                      ? `${formatInt(caseFile.capture.parties.captured)} de ${formatInt(caseFile.capture.parties.declared ?? 0)} participantes`
                      : plural(caseFile.capture.parties.captured, 'participante', 'participantes')
                  }
                </p>
              </header>

              <CoverageNotice
                value={caseFile.capture.parties}
                noun="partes"
                cause="El Datascroller de la ficha solo pinta las diez primeras y no expone las siguientes."
              />

              <ul class="parties">
                {
                  caseFile.parties.map((p) => (
                    <li class="party">
                      <span class="party__polo">{poloLabel[p.polo]}</span>
                      <div class="party__info">
                        <p class="party__name">{p.name}</p>
                        <p class="party__docs">
                          {p.documentNumber && (
                            <span class="mono">
                              {p.documentType === 'cnpj' ? 'CNPJ' : 'CPF'} {p.documentNumber}
                            </span>
                          )}
                          {p.oab && <span class="mono">OAB {p.oab}</span>}
                        </p>
                      </div>
                      <span class="party__role">{p.role ?? '—'}</span>
                    </li>
                  ))
                }
              </ul>
            </section>

            <section class="block">
              <header class="section-head">
                <h2 class="section-head__title">03 — MOVIMIENTOS</h2>
                <p class="section-head__aside">
                  {
                    isPartial(caseFile.capture.movements)
                      ? `${formatInt(caseFile.capture.movements.captured)} de ${formatInt(caseFile.capture.movements.declared ?? 0)} registros`
                      : plural(caseFile.capture.movements.captured, 'registro', 'registros')
                  }
                </p>
              </header>

              <CoverageNotice
                value={caseFile.capture.movements}
                noun="movimientos"
                cause="La tabla de movimentações se cortó antes de terminar de paginar."
              />

              <ol class="movements">
                {
                  movements.map((m) => (
                    <li class="movement">
                      <span class="movement__ts mono">{m.timestamp ?? '—'}</span>
                      <span class="movement__text">{m.description}</span>
                    </li>
                  ))
                }
              </ol>

              {
                caseFile.movements.length > MOVEMENT_PREVIEW && (
                  <p class="more">
                    {showAllMovements ? (
                      <a href={`/expedientes/${caseFile.number}`}>← Ver solo los últimos {MOVEMENT_PREVIEW}</a>
                    ) : (
                      <a href={`/expedientes/${caseFile.number}?movimientos=todos`}>
                        Ver los {formatInt(caseFile.movements.length)} movimientos →
                      </a>
                    )}
                  </p>
                )
              }
            </section>
          </div>

          <aside class="split__aside side">
            <section class="capture">
              <header class="capture__head">
                <h2 class="field-label">ESTADO DE CAPTURA</h2>
                <span class:list={['status-pill', partial && 'status-pill--warn']}>
                  <span class:list={['dot', partial ? 'dot--warn' : 'dot--ok']}></span>
                  {partial ? 'Incompleto' : 'Completo'}
                </span>
              </header>

              {
                (
                  [
                    ['Documentos', caseFile.capture.documents],
                    ['Movimientos', caseFile.capture.movements],
                    ['Partes', caseFile.capture.parties],
                  ] as const
                ).map(([label, cov]) => (
                  <p class="capture__row">
                    <span class="capture__key">{label}</span>
                    <span class:list={['mono', 'num', isPartial(cov) && 'partial']}>
                      {formatInt(cov.captured)} de {formatInt(cov.declared ?? cov.captured)}
                    </span>
                  </p>
                ))
              }

              <p class="capture__row">
                <span class="capture__key">Última captura</span>
                <span class="mono capture__muted">
                  {caseFile.capture.lastCaptureAt ?? '—'}
                  {caseFile.capture.requestCount !== null &&
                    ` · ${formatInt(caseFile.capture.requestCount)} peticiones`}
                </span>
              </p>

              {
                partial && (
                  <p class="capture__foot">
                    El primer número es lo que se pudo leer; el segundo, lo que el portal declara.
                    Mientras no coincidan, el expediente está incompleto.
                  </p>
                )
              }

              {
                caseFile.capture.failures.length > 0 && (
                  <ul class="capture__failures">
                    {caseFile.capture.failures.map((f) => (
                      <li class="capture__failure">
                        <span class="capture__failure-top">
                          <span class="mono">{f.kind}</span>
                          <span class="mono capture__failure-when">
                            {f.attempts} {f.attempts === 1 ? 'intento' : 'intentos'} · {f.lastAttemptAt}
                          </span>
                        </span>
                        <span class="capture__failure-text" title={f.raw}>{f.error}</span>
                      </li>
                    ))}
                  </ul>
                )
              }
            </section>

            <section class="block">
              <header class="section-head">
                <h2 class="section-head__title">04 — DOCUMENTOS</h2>
                <p class="section-head__aside">
                  {plural(caseFile.documents.length, 'archivo', 'archivos')}
                  {caseFile.documentsBytes !== null && ` · ${formatBytes(caseFile.documentsBytes)}`}
                </p>
              </header>

              <CoverageNotice
                value={caseFile.capture.documents}
                noun="documentos"
                cause="La descarga se detuvo en un 429 del portal y quedó pendiente de reintento."
              />

              {
                caseFile.documents.length === 0 ? (
                  <p class="empty">El expediente todavía no tiene documentos en el portal.</p>
                ) : (
                  <ul class="docs">
                    {caseFile.documents.map((d) => (
                      <li class="doc">
                        <Icon name={d.format === 'HTML' ? 'file-code' : 'file-text'} size={15} />
                        <span class="doc__date mono">{d.docDate ?? '—'}</span>
                        <span class="doc__label">
                          {d.label}
                          {d.sizeBytes !== null && (
                            <span class="doc__size mono"> · {formatBytes(d.sizeBytes)}</span>
                          )}
                        </span>
                        <span class="doc__fmt mono">{d.format}</span>
                        <span class="doc__actions">
                          <a
                            class="doc__action doc__action--view"
                            href={`/documentos/${d.id}`}
                            target="_blank"
                            rel="noopener"
                            data-view={d.id}
                            data-label={d.label}
                            data-format={d.format}
                            aria-label={`Previsualizar ${d.label}`}
                            title="Previsualizar"
                          >
                            <Icon name="eye" size={15} />
                          </a>
                          <a
                            class="doc__action"
                            href={`/documentos/${d.id}?descargar`}
                            aria-label={`Descargar ${d.label}`}
                            title="Descargar"
                          >
                            <Icon name="download" size={15} />
                          </a>
                        </span>
                      </li>
                    ))}
                  </ul>
                )
              }
            </section>
          </aside>
        </div>

        {/*
          The viewer. It is a real <dialog>, so Esc closes it, focus is trapped
          while it is open and the page behind it is inert — none of which is
          worth hand-rolling. The PDF is shown by the browser's own viewer in an
          iframe: these files were downloaded to be read, and sending somebody
          to a separate tab to read one is not a preview.

          It stays empty until something is opened, so a case file with forty
          documents costs one iframe, not forty.
        */}
        <dialog class="viewer" id="viewer" aria-label="Documento">
          <header class="viewer__bar">
            <span class="viewer__title" id="viewer-title" />
            <span class="viewer__count mono" id="viewer-count" />
            <span class="viewer__spacer" />
            <button class="viewer__btn" type="button" id="viewer-prev" title="Documento anterior (←)" aria-label="Documento anterior">
              <Icon name="chevron-left" size={16} />
            </button>
            <button class="viewer__btn" type="button" id="viewer-next" title="Documento siguiente (→)" aria-label="Documento siguiente">
              <Icon name="chevron-right" size={16} />
            </button>
            <a class="viewer__btn" id="viewer-download" href="#" title="Descargar" aria-label="Descargar">
              <Icon name="download" size={16} />
            </a>
            <a class="viewer__btn" id="viewer-tab" href="#" target="_blank" rel="noopener" title="Abrir en una pestaña" aria-label="Abrir en una pestaña">
              <Icon name="external-link" size={16} />
            </a>
            <button class="viewer__btn viewer__btn--close" type="button" id="viewer-close" title="Cerrar (Esc)" aria-label="Cerrar">
              <Icon name="x" size={16} />
            </button>
          </header>
          <iframe class="viewer__frame" id="viewer-frame" title="Documento" />
        </dialog>
      </>
    )
  }
</Base>

<script>
  /**
   * Two small jobs, both of which exist because the page would otherwise be
   * silent about something happening: reading a document without leaving the
   * case, and showing a queued capture actually progressing.
   *
   * Plain DOM on purpose — this is the only interactive corner of the app, and
   * a framework to run it would be a dependency the rest of the site does not
   * want.
   */
  const dialog = document.getElementById('viewer') as HTMLDialogElement | null
  const frame = document.getElementById('viewer-frame') as HTMLIFrameElement | null

  if (dialog && frame) {
    const title = document.getElementById('viewer-title')!
    const count = document.getElementById('viewer-count')!
    const download = document.getElementById('viewer-download') as HTMLAnchorElement
    const tab = document.getElementById('viewer-tab') as HTMLAnchorElement
    const prev = document.getElementById('viewer-prev') as HTMLButtonElement
    const next = document.getElementById('viewer-next') as HTMLButtonElement

    // Every document on the page, in the order they are listed, so the arrows
    // walk the case file the way a reader would.
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('a[data-view]'),
    )
    let at = 0

    const show = (index: number): void => {
      const link = links[index]
      if (!link) return
      at = index
      const id = link.dataset.view
      title.textContent = link.dataset.label ?? ''
      count.textContent = `${index + 1} / ${links.length}`
      // Assigned rather than pushed as a new src attribute each time: the same
      // frame is reused, so opening a fortieth document costs no more than the
      // first.
      frame.src = `/documentos/${id}`
      download.href = `/documentos/${id}?descargar`
      tab.href = `/documentos/${id}`
      prev.disabled = index === 0
      next.disabled = index === links.length - 1
    }

    for (const [index, link] of links.entries()) {
      link.addEventListener('click', (event) => {
        // Ctrl/⌘-click, middle click and "open in new tab" keep working: the
        // eye is still a real link, and this only takes over the plain click.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return
        event.preventDefault()
        show(index)
        dialog.showModal()
      })
    }

    prev.addEventListener('click', () => show(at - 1))
    next.addEventListener('click', () => show(at + 1))
    document.getElementById('viewer-close')!.addEventListener('click', () => dialog.close())

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(at - 1) }
      if (event.key === 'ArrowRight') { event.preventDefault(); show(at + 1) }
    })

    // Dropping the src on close stops a PDF rendering behind a closed dialog,
    // and means reopening always starts from the top of the document.
    dialog.addEventListener('close', () => { frame.removeAttribute('src') })

    // A click on the backdrop lands on the dialog itself, never on its content.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close()
    })
  }

  /**
   * The queued-capture banner. It polls only while there is something to watch
   * and stops the moment the queue goes quiet, so a finished page makes no
   * requests at all.
   */
  const banner = document.querySelector<HTMLElement>('[data-live-job]')
  if (banner) {
    const jobId = Number(banner.dataset.liveJob)
    const text = banner.querySelector<HTMLElement>('.queued__text')!
    const progress = banner.querySelector<HTMLElement>('.queued__progress')!

    const tick = async (): Promise<void> => {
      let payload: any
      try {
        const response = await fetch('/cola.json', { headers: { accept: 'application/json' } })
        if (!response.ok) return
        payload = await response.json()
      } catch {
        // A poll that fails is not worth reporting: the work is happening in
        // another process either way, and the next tick will say so.
        return
      }

      const job = payload.jobs?.find((j: any) => j.id === jobId)
      if (job) {
        const { done, total, totalIsEstimate } = job.progress ?? {}
        progress.textContent =
          job.state === 'running' && typeof done === 'number' && done > 0
            ? (total ? `${done} / ${totalIsEstimate ? '~' : ''}${total}` : String(done))
            : ''

        if (job.state === 'done') {
          text.textContent = 'Recaptura terminada. Recarga para ver lo nuevo.'
          banner.classList.add('queued--done')
          banner.querySelector('.dot')?.classList.remove('dot--ok')
        } else if (job.state === 'failed') {
          text.textContent = `La recaptura falló: ${job.error ?? 'sin motivo registrado'}`
          banner.classList.add('queued--bad')
        } else if (job.state === 'running') {
          // The engine's own words when it has any: "reading the case file"
          // beats "recapturando…" precisely because it changes.
          text.textContent = job.stage
            ? `Recapturando: ${job.stage}`
            : 'Recapturando este expediente…'
        }
      }

      if (payload.active) setTimeout(tick, 1500)
    }

    void tick()
  }
</script>

<style>
  /* The queued-capture banner: present only after a refresh was asked for. */
  .queued {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    padding: 9px 12px;
    border: 1px solid var(--line);
    border-left: 2px solid var(--ok);
    background: var(--surface);
    font-size: 13px;
    color: var(--ink-2);
  }
  .queued--done { border-left-color: var(--line-strong); }
  .queued--bad { border-left-color: var(--bad); color: var(--bad); }
  .queued__text { flex: 1 1 auto; }
  .queued__progress { color: var(--ink); font-size: 12px; }
  .queued__progress:empty { display: none; }
  .queued__link { color: var(--ink-2); text-underline-offset: 3px; }
  .queued__link:hover { color: var(--ink); }
  .case-head__refresh { margin: 0; }

  /*
    The document viewer. Sized against the viewport rather than its content:
    a PDF has no intrinsic height to lay out against, so without this the
    dialog collapses to nothing and shows a sliver of the first page.
  */
  .viewer {
    width: min(1100px, 94vw);
    height: min(88vh, 1000px);
    max-width: none;
    max-height: none;
    padding: 0;
    border: 1px solid var(--line-strong);
    background: var(--paper);
    color: var(--ink);
    /* Overriding the UA centring, which leaves the dialog top-left in some
       browsers once width and height are set explicitly. */
    margin: auto;
  }
  .viewer::backdrop { background: rgb(17 17 17 / 42%); }

  .viewer__bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px 8px 14px;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }
  .viewer__title {
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .viewer__count { font-size: 11px; color: var(--ink-3); }
  .viewer__spacer { flex: 1 1 auto; }

  .viewer__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 1px solid transparent;
    background: none;
    color: var(--ink-2);
    cursor: pointer;
  }
  .viewer__btn:hover { border-color: var(--line); color: var(--ink); background: var(--paper); }
  .viewer__btn:disabled { opacity: 0.3; cursor: default; }
  .viewer__btn:disabled:hover { border-color: transparent; background: none; color: var(--ink-2); }
  .viewer__btn--close { margin-left: 4px; }

  .viewer__frame {
    display: block;
    width: 100%;
    /* The bar is 45px; the frame takes the rest so the PDF fills the dialog. */
    height: calc(100% - 45px);
    border: 0;
    background: var(--surface);
  }

  @media (max-width: 640px) {
    .viewer { width: 100vw; height: 100vh; border: 0; }
    .viewer__frame { height: calc(100% - 45px); }
  }

  .missing {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-block: 80px 120px;
  }
  .missing__actions { display: flex; gap: 10px; flex-wrap: wrap; }

  .case-head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 44px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }
  .crumbs { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ink-3); }
  .crumbs a:hover { color: var(--ink-2); }
  .crumbs .mono { color: var(--ink-2); }

  .case-head__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    flex-wrap: wrap;
  }
  .case-head__number {
    font-size: clamp(1.75rem, 3vw, 2.625rem);
    font-weight: 300;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .case-head__tags {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 10px;
    font-size: 15px;
    font-weight: 300;
    color: var(--ink-2);
  }
  .case-head__tags .mono { font-size: 13px; color: var(--ink-3); }
  .case-head__tags .sep { color: var(--ink-3); }
  .case-head__actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .case-head__actions .btn:disabled { opacity: 1; cursor: default; }

  .meta {
    display: flex;
    flex-wrap: wrap;
