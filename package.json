{
  "name": "pje-trf5-scraper",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "scraper": "node --experimental-strip-types packages/scraper/src/cli.ts",
    "check:runtime": "node --experimental-strip-types -e \"import('./packages/core/src/index.ts').then(()=>console.log('runtime import OK'))\""
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.2.0"
  }
}
