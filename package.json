{
  "name": "pje-trf5-scraper",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "demo/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/scraper && tsc --noEmit -p demo/worker && tsc --noEmit -p demo/web/tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "scraper": "node --experimental-strip-types packages/scraper/src/cli.ts",
    "check:runtime": "node --experimental-strip-types -e \"Promise.all([import('./packages/core/src/index.ts'),import('./packages/scraper/src/index.ts'),import('./demo/worker/src/index.ts')]).then(()=>console.log('runtime import OK'))\"",
    "worker": "node --experimental-strip-types demo/worker/src/cli.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.2.0"
  }
}
